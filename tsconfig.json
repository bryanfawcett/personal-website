{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*.astro",
    "**/*.ts"
  ],
  "exclude": [
    "dist",
    ".astro",
    "worker-configuration.d.ts",
    "bryans-adventures"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}
