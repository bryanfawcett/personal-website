{
  "name": "bryanfawcett-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "lint": "astro check",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "og": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/build-og-card.mjs",
    "verify:images": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/verify-image-urls.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:stylesheet": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/verify-stylesheet.mjs",
    "nav-portrait": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/build-nav-portrait.mjs",
    "cjk": "node scripts/build-cjk-subset.mjs"
  },
  "dependencies": {
    "@bundu/ui": "0.14.0",
    "@portabletext/to-html": "^6.0.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/sitemap": "^3.7.5",
    "@types/qrcode": "^1.5.6",
    "apca-w3": "^0.1.9",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "^0.35.5",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "zod@<4.6.6": "^4.6.6"
    }
  }
}
