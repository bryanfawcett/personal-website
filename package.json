{
  "name": "bryanfawcett-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vp run tokens && vp exec astro dev",
    "build": "vp run tokens && vp exec astro build",
    "preview": "cf dev",
    "check": "vp exec astro check",
    "lint": "vp lint",
    "deploy": "cf deploy",
    "og": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/build-og-card.mjs",
    "verify:images": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/verify-image-urls.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:stylesheet": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/verify-stylesheet.mjs",
    "nav-portrait": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/build-nav-portrait.mjs",
    "cjk": "node scripts/build-cjk-subset.mjs",
    "fmt": "vp fmt",
    "verify:images:rs": "cargo run -q --manifest-path tools/Cargo.toml -p verify-image-urls",
    "verify:stylesheet:rs": "cargo run -q --manifest-path tools/Cargo.toml -p verify-stylesheet",
    "tokens": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/build-tokens.mjs",
    "site-data": "node --experimental-strip-types --import ./scripts/ts-specifier-hook.mjs scripts/export-site-data.mjs",
    "verify:contact:rs": "scripts/verify-contact-parity.sh",
    "verify:components:rs": "cargo run -q --manifest-path tools/Cargo.toml -p components --bin parity",
    "design-system": "python3 scripts/build-design-system.py",
    "design-system:check": "python3 scripts/build-design-system.py --check"
  },
  "dependencies": {
    "@bundu/ui": "0.14.0",
    "@portabletext/to-html": "^6.0.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^15.0.0-beta.5",
    "@astrojs/sitemap": "^3.7.5",
    "@types/qrcode": "^1.5.6",
    "apca-w3": "^0.1.9",
    "cf": "1.0.0-beta.32",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite-plus": "^1.6.0"
  }
}
