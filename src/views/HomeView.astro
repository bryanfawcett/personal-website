---
/**
 * The home sheet, in whichever language it is asked for.
 *
 * The page files under `src/pages` are thin wrappers around this — one per
 * language — so a copy edit or a layout change happens once. Duplicating the
 * markup into `pages/zh/` would mean every future change had to be made twice
 * and would drift the first time someone forgot.
 *
 * One visitor, one action: an organisation deciding whether to hire Nyuchi,
 * and a scoping call. Every section either shows them who the work is for,
 * proves it with a system that exists, or says how a job runs. The full
 * ecosystem grid lives on /experience.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Panel from '../components/Panel.astro';
import ContactCard from '../components/ContactCard.astro';
import Portrait from '../components/Portrait.astro';
import WorkshopStrip from '../components/WorkshopStrip.astro';
import { PROFILE, profileInLang, socialsInLang } from '../data/profile.js';
import { audiences, steps, systems } from '../data/work.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);

const ref = (i: number) => String(i + 1).padStart(2, '0');
const book = localizePath('/book', lang);
---

<BaseLayout
  title={`${PROFILE.name} — ${profile.title}`}
  description={profile.summary}
  path="/"
  lang={lang}
  sheet="01 / 06"
  ogType="profile"
>
  <Hero
    eyebrow={t('home.eyebrow')}
    solid={t('home.solid')}
    drafted={t('home.drafted')}
    sub={t('home.sub')}
    note={t('home.note')}
    dimension={t('home.dimension')}
    lang={lang}
    showByline
  >
    <a class="btn" href={book}>{t('home.cta_primary')}</a>
    <a class="btn is-ghost" href="#systems">{t('home.cta_secondary')}</a>
  </Hero>

  <!-- Workshop views -->
  <div class="section reveal">
    <WorkshopStrip lang={lang} />
  </div>

  <!-- Who we build for -->
  <section class="section reveal" id="who" aria-labelledby="who-heading">
    <div class="section-head">
      <p class="eyebrow is-open">{t('home.who_eyebrow')}</p>
      <span class="margin-note">{t('home.who_note')}</span>
    </div>
    <h2 class="visually-hidden" id="who-heading">{t('home.who_heading')}</h2>

    <div class="board">
      {
        audiences(lang).map((audience) => (
          <Panel class="w4" mineral={audience.mineral}>
            <h3>{audience.title}</h3>
            <p>{audience.body}</p>
          </Panel>
        ))
      }
    </div>
  </section>

  <!-- Three systems -->
  <section class="section reveal" id="systems" aria-labelledby="systems-heading">
    <div class="section-head">
      <p class="eyebrow is-open">{t('home.systems_eyebrow')}</p>
      <span class="margin-note">{t('home.systems_note')}</span>
    </div>
    <h2 class="visually-hidden" id="systems-heading">{t('home.systems_heading')}</h2>

    <div class="systems">
      {
        systems(lang).map((system, i) => (
          <Panel class="system" mineral={system.mineral} fig={`${t('home.systems_fig')} ${ref(i)}`}>
            <p class="system__org">{system.org}</p>
            <h3>{system.title}</h3>
            <dl class="system__spec">
              <dt>{t('home.systems_people')}</dt>
              <dd>{system.people}</dd>
              <dt>{t('home.systems_system')}</dt>
              <dd>{system.system}</dd>
              <dt>{t('home.systems_result')}</dt>
              <dd>{system.result}</dd>
            </dl>
            <ul class="system__links">
              {system.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} →
                  </a>
                </li>
              ))}
            </ul>
          </Panel>
        ))
      }
    </div>
  </section>

  <!-- How a job runs -->
  <section class="section reveal" id="process" aria-labelledby="steps-heading">
    <div class="section-head">
      <p class="eyebrow is-open">{t('home.steps_eyebrow')}</p>
      <span class="margin-note">{t('home.steps_note')}</span>
    </div>
    <h2 class="visually-hidden" id="steps-heading">{t('home.steps_heading')}</h2>

    <ol class="board steps">
      {
        steps(lang).map((step, i) => (
          <Panel as="li" class="w6" fig={`${t('home.steps_fig')} ${ref(i)}`}>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </Panel>
        ))
      }
    </ol>
  </section>

  <!-- Message from the bench -->
  <section class="section reveal" aria-labelledby="quote-heading">
    <h2 class="visually-hidden" id="quote-heading">{t('home.quote_heading')}</h2>
    <Panel fig={t('home.quote_fig')} class="quote">
      <Portrait width={176} caption={t('card.fig')} class="quote__portrait" lang={lang} eager />

      <div class="quote__body">
        <blockquote>
          {t('home.quote_before')}<strong>{t('home.quote_build')}</strong>{t('home.quote_middle')}<strong
            >{t('home.quote_who')}</strong
          >{t('home.quote_after')}
        </blockquote>
        <span class="quote__sig hand">{t('home.quote_sig')}</span>
      </div>
    </Panel>
  </section>

  <!-- The wider drawing -->
  <section class="section reveal" aria-labelledby="bigger-heading">
    <Panel fig={t('home.bigger_fig')} mineral="copper" class="bigger">
      <h2 id="bigger-heading">{t('home.bigger_heading')}</h2>
      <p>{t('home.bigger_body')}</p>
      <ul class="system__links">
        <li>
          <a href={`${localizePath('/experience', lang)}#ecosystem`}>{t('home.bigger_all')} →</a>
        </li>
        <li>
          <a href="https://bundu.org" target="_blank" rel="noopener noreferrer"
            >{t('home.bigger_bundu')} →</a
          >
        </li>
      </ul>
    </Panel>
  </section>

  <!-- Connect -->
  <section class="section reveal" id="connect" aria-labelledby="connect-heading">
    <Panel fig={t('home.connect_fig')} class="connect">
      <span class="stamp">{t('home.connect_stamp')}</span>
      <h2 id="connect-heading">{t('home.connect_heading')}</h2>
      <p class="connect__lede">{t('home.connect_lede')}</p>
      <ContactCard class="connect__card" lang={lang} />

      <ul class="socials">
        {
          socialsInLang(lang)
            .filter((s) => s.href.startsWith('http'))
            .map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">
                  {social.name}
                </a>
              </li>
            ))
        }
      </ul>

      <a class="btn" href={book}>{t('home.connect_cta')}</a>
    </Panel>
  </section>
</BaseLayout>
