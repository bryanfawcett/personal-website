---
/** The experience sheet, in whichever language it is asked for. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { coreSkills, credentials, roles } from '../data/experience.js';
import { nyuchiProjectsByGroup, sasProjects } from '../data/work.js';
import { MINERALS } from '../brand/minerals.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const ecosystem = nyuchiProjectsByGroup(lang);
const sas = sasProjects(lang);
---

<BaseLayout
  title={t('exp.title')}
  description={t('exp.lede')}
  path="/experience"
  lang={lang}
  sheet="02 / 06"
>
  <PageHeader
    eyebrow={t('exp.eyebrow')}
    title={t('exp.title')}
    lede={t('exp.lede')}
    note={t('exp.note')}
  />

  <section class="section reveal" aria-labelledby="roles-heading">
    <h2 class="visually-hidden" id="roles-heading">{t('exp.roles_heading')}</h2>

    <ol class="schedule">
      {
        roles(lang).map((role, index) => (
          <li
            class="schedule__row"
            data-mineral={MINERALS[index % MINERALS.length]!.name}
          >
            <div class="schedule__meta">
              <span class="schedule__ref">{String(index + 1).padStart(2, '0')}</span>
              <span class="schedule__period">{role.period}</span>
              <span class="schedule__place">{role.location}</span>
              {role.duration && <span class="chip">{role.duration}</span>}
            </div>

            <div class="schedule__body">
              <h3 class="schedule__title">{role.title}</h3>
              <p class="schedule__company">{role.company}</p>

              <ul class="schedule__points">
                {role.description.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              {role.skills && (
                <ul class="chips">
                  {role.skills.map((skill) => (
                    <li class="chip">{skill}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section reveal" aria-labelledby="credentials-heading">
    <p class="eyebrow is-open">{t('exp.credentials_eyebrow')}</p>
    <h2 class="visually-hidden" id="credentials-heading">{t('exp.credentials_heading')}</h2>

    <div class="credentials">
      {
        credentials(lang).map((credential) => (
          <Panel class="credential">
            <h3>{credential.title}</h3>
            <p class="credential__issuer">{credential.issuer}</p>
            <p class="credential__period">{credential.period}</p>
          </Panel>
        ))
      }
    </div>
  </section>

  <section class="section reveal" aria-labelledby="skills-heading">
    <p class="eyebrow is-open">{t('exp.skills_eyebrow')}</p>
    <h2 class="visually-hidden" id="skills-heading">{t('exp.skills_heading')}</h2>

    <ul class="chips chips--large">
      {coreSkills(lang).map((skill) => <li class="chip">{skill}</li>)}
    </ul>
  </section>

  <!--
    Everything at the bench. This used to be the home page's middle; the home
    sheet now carries three systems and one action, and this is where the
    whole grid lives. The tiles keep their data-track-* attributes, and the
    delegated listener in BaseLayout counts them here exactly as it did on /.
  -->
  <section class="section reveal" id="ecosystem" aria-labelledby="ecosystem-heading">
    <p class="eyebrow is-open">{t('exp.ecosystem_eyebrow')}</p>
    <h2 class="visually-hidden" id="ecosystem-heading">{t('exp.ecosystem_heading')}</h2>

    <p class="group-label">{t('exp.ecosystem_group')}</p>
    <p class="lede">{t('exp.ecosystem_lede')}</p>

    {
      ecosystem.map((section) => (
        <div class="cluster">
          <p class="cluster__label">{section.label}</p>
          <div class="board board--tight">
            {section.projects.map((project) => (
              <Panel
                as="a"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="col-4 link-panel"
                mineral={project.mineral}
                data-track-project={project.key}
                data-track-group={section.group}
              >
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <span class="link-panel__path">{t('exp.ecosystem_visit')}</span>
              </Panel>
            ))}
          </div>
        </div>
      ))
    }

    <p class="group-label">{t('exp.ecosystem_sas')}</p>
    <div class="board board--tight">
      {
        sas.map((project) =>
          project.href ? (
            <Panel
              as="a"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="col-6 link-panel"
              mineral={project.mineral}
            >
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="link-panel__path">{t('exp.ecosystem_repo')}</span>
            </Panel>
          ) : (
            <Panel as="div" class="col-6 link-panel link-panel--static" mineral={project.mineral}>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </Panel>
          ),
        )
      }
    </div>

    <p class="prose">
      <a href={localizePath('/how-this-was-built', lang)}>{t('build.page_link')}</a>
    </p>
  </section>
</BaseLayout>
