---
/** The origins sheet, in whichever language it is asked for. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { journey, nyuchiWork, openQuestions, pinkAptitudes, schoolWork } from '../data/origins.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const PRESENTATION_URL = 'https://origins-with-perspective.nyuchi.workers.dev';
const PINK_URL = 'https://www.danpink.com/books/whole-new-mind/';
---

<BaseLayout
  title={t('origins.title')}
  description={t('origins.description')}
  path="/origins-with-perspective"
  lang={lang}
  sheet="04 / 06"
  ogType="article"
>
  <PageHeader
    eyebrow={t('origins.eyebrow')}
    title={t('origins.title')}
    lede={t('origins.lede')}
    note={t('origins.note')}
  >
    <p class="header-actions">
      <a class="btn" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
        {t('origins.open_deck')}
      </a>
    </p>
  </PageHeader>

  <!-- Why -->
  <section class="section reveal" aria-labelledby="why-heading">
    <p class="eyebrow is-open">{t('origins.why_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="why-heading">{t('origins.why_heading')}</h2>

    <div class="prose">
      <p>{t('origins.why_p1')}</p>
      <p>
        {t('origins.why_p2_before')}<em>{t('origins.why_p2_em')}</em>{t('origins.why_p2_after')}
      </p>
      <p>{t('origins.why_p3')}</p>
    </div>
  </section>

  <!-- The argument -->
  <section class="section reveal" aria-labelledby="argument-heading">
    <p class="eyebrow is-open">{t('origins.argument_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="argument-heading">{t('origins.argument_heading')}</h2>

    <div class="prose">
      <p>{t('origins.argument_p1')}</p>
      <p>{t('origins.argument_p2')}</p>
    </div>

    <blockquote class="pull">{t('origins.argument_pull')}</blockquote>

    <div class="prose">
      <p>{t('origins.argument_p3')}</p>
    </div>
  </section>

  <!-- Journey -->
  <section class="section reveal" aria-labelledby="journey-heading">
    <p class="eyebrow is-open">{t('origins.journey_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="journey-heading">{t('origins.journey_heading')}</h2>
    <p class="lede">{t('origins.journey_lede')}</p>

    <ol class="journey">
      {
        journey(lang).map((stop) => (
          <li class="journey__item" style={`--stop-mineral: var(--mineral-${stop.mineral})`}>
            <p class="journey__meta">
              {stop.period} &middot; {stop.place}
            </p>
            <h3 class="journey__title">{stop.title}</h3>
            <p class="journey__body">{stop.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Current work -->
  <section class="section reveal" aria-labelledby="now-heading">
    <p class="eyebrow is-open">{t('origins.now_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="now-heading">{t('origins.now_heading')}</h2>
    <p class="lede">{t('origins.now_lede')}</p>

    <div class="columns">
      <div>
        <p class="eyebrow is-open">{t('origins.now_sas')}</p>
        <ul class="work-list">
          {
            schoolWork(lang).map((item) => (
              <Panel as="li" style={`--item-mineral: var(--mineral-${item.mineral})`}>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </Panel>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow is-open">{t('origins.now_nyuchi')}</p>
        <ul class="work-list">
          {
            nyuchiWork(lang).map((item) => (
              <Panel as="li" style={`--item-mineral: var(--mineral-${item.mineral})`}>
                <h3>
                  {item.href ? (
                    <a href={item.href} target="_blank" rel="noopener noreferrer">
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p>{item.detail}</p>
              </Panel>
            ))
          }
        </ul>
      </div>
    </div>

    <Panel as="div" class="aside"><p>{t('origins.now_aside')}</p></Panel>
  </section>

  <!-- Conceptual age -->
  <section class="section reveal" aria-labelledby="pink-heading">
    <p class="eyebrow is-open">{t('origins.pink_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="pink-heading">{t('origins.pink_heading')}</h2>

    <div class="prose">
      <p>
        {t('origins.pink_p1_before')}<a href={PINK_URL} target="_blank" rel="noopener noreferrer"
          >{t('origins.pink_p1_link')}</a
        >{t('origins.pink_p1_after')}
      </p>
      <p>{t('origins.pink_p2')}</p>
    </div>

    <ul class="aptitudes">
      {
        pinkAptitudes(lang).map((aptitude) => (
          <Panel as="li" style={`--aptitude-mineral: var(--mineral-${aptitude.mineral})`}>
            <h3>{aptitude.name}</h3>
            <p>{aptitude.detail}</p>
          </Panel>
        ))
      }
    </ul>
  </section>

  <!-- Questions -->
  <section class="section reveal" aria-labelledby="questions-heading">
    <p class="eyebrow is-open">{t('origins.questions_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="questions-heading">{t('origins.questions_heading')}</h2>
    <p class="lede">{t('origins.questions_lede')}</p>

    <ul class="questions">
      {
        openQuestions(lang).map((question) => (
          <Panel as="li" style={`--question-mineral: var(--mineral-${question.mineral})`}>
            <h3>{question.title}</h3>
            <p>{question.body}</p>
          </Panel>
        ))
      }
    </ul>

    <blockquote class="pull">{t('origins.questions_pull')}</blockquote>
  </section>

  <!-- Presentation -->
  <section class="section reveal" aria-labelledby="deck-heading">
    <p class="eyebrow is-open">{t('origins.deck_eyebrow')}</p>
    <h2 class="section-title sheet-h2" id="deck-heading">{t('origins.deck_heading')}</h2>
    <p class="lede">{t('origins.deck_lede')}</p>

    <Panel as="div" class="deck">
      <iframe src={PRESENTATION_URL} title={t('origins.deck_iframe_title')} loading="lazy"></iframe>
    </Panel>

    <p class="header-actions">
      <a class="btn" href={PRESENTATION_URL} target="_blank" rel="noopener noreferrer">
        {t('origins.deck_fullscreen')}
      </a>
    </p>
  </section>

  <!-- CTA -->
  <section class="section reveal" aria-labelledby="cta-heading">
    <h2 class="section-title sheet-h2" id="cta-heading">{t('origins.cta_heading')}</h2>
    <p class="lede">{t('origins.cta_lede')}</p>
    <p class="header-actions">
      <a class="btn" href={localizePath('/book', lang)}>{t('origins.cta_book')}</a>
      <a class="button is-ghost" href="mailto:bryan@nyuchi.com">bryan@nyuchi.com</a>
    </p>
  </section>
</BaseLayout>

<style>
  .sheet-h2 {
    margin-block: 0.75rem 1.5rem;
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
  }


  .prose {
    max-width: var(--measure);
    font-size: 1.125rem;
    line-height: 1.62;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--ink-body);
  }

  .prose em {
    color: var(--ink);
    font-style: normal;
  }

  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pull {
    max-width: var(--measure);
    margin-block: 2.5rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 3px solid var(--mineral-gold);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.625rem);
    font-weight: 300;
    color: var(--ink);
    text-wrap: balance;
  }

  /* --- journey --- */

  .journey {
    list-style: none;
    padding: 0;
    margin-block-start: 2.5rem;
  }

  .journey__item {
    position: relative;
    padding: 0 0 2.25rem 2rem;
    border-inline-start: 1px solid var(--ink-faint);
  }

  .journey__item:last-child {
    padding-block-end: 0;
    border-inline-start-color: transparent;
  }

  .journey__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -5px;
    inset-block-start: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: var(--stop-mineral);
  }

  .journey__meta {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .journey__title {
    margin-block: 0.35rem 0.5rem;
    font-size: 1.3125rem;
    font-weight: 300;
  }

  .journey__body {
    max-width: var(--measure);
    font-size: 1.0625rem;
    line-height: 1.58;
    color: var(--ink-body);
  }

  /* --- columns --- */

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 2.5rem;
    margin-block-start: 2.5rem;
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin-block-start: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-list li {
    padding: 1rem 1.25rem;
    border-inline-start: 3px solid var(--item-mineral);
  }

  .work-list h3 {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 500;
    margin-block-end: 0.25rem;
  }

  /*
   * These are standalone heading links, not links inside a sentence, so the
   * WCAG 2.2 target-size inline exception does not apply — they carry the
   * full 44px target.
   */
  .work-list h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .work-list h3 a:hover {
    color: var(--item-mineral);
  }

  .work-list p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-body);
  }

  .aside {
    max-width: var(--measure);
    margin-block-start: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0;
    font-size: 1.0625rem;
    line-height: 1.58;
    color: var(--ink-body);
  }

  /* --- aptitudes & questions --- */

  .aptitudes,
  .questions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-block-start: 2rem;
  }

  .aptitudes li,
  .questions li {
    padding: 1.25rem 1.5rem;
    border-radius: 0;
  }

  .aptitudes h3,
  .questions h3 {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 500;
    margin-block-end: 0.35rem;
  }

  .aptitudes h3 {
    color: var(--aptitude-mineral);
  }

  .questions h3 {
    color: var(--question-mineral);
  }

  .aptitudes p,
  .questions p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-body);
  }

  /* --- deck --- */

  .deck {
    margin-block-start: 2rem;
    border-radius: 0;
    overflow: hidden;
  }

  .deck iframe {
    display: block;
    width: 100%;
    height: min(70dvh, 40rem);
    min-height: 30rem;
    border: 0;
  }

  /* Han text in the mono-set metadata takes the CJK stack and its own case. */
  .journey__meta:lang(zh) {
    font-family: var(--cjk-mono);
    letter-spacing: 0.1em;
    text-transform: none;
  }
</style>
