---
/**
 * The rail, explained — in whichever language it is asked for.
 *
 * The seven segments running down the binding edge are the site's only
 * saturated colour, and nowhere said what they were. Every figure on this
 * page — the contrast ratios especially — is computed at build time from the
 * same tokens the rail draws with, so the page cannot drift from the rail.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { MINERALS } from '../brand/minerals.js';
import { EXPERIMENTAL, HERITAGE, colorVar } from '../brand/palette.js';
import { SHEET } from '../brand/tokens.js';
import { rating, ratio } from '../brand/contrast.js';
import { EXPERIMENTAL_ZH, HERITAGE_ZH, MINERALS_ZH } from '../data/minerals-i18n.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const MZIZI = 'https://mzizi.dev';

/**
 * Measured against the sheet the rail is actually drawn on.
 *
 * The token name is the mineral's identity and stays in Latin script in both
 * languages — it is what `--mineral-cobalt` is called in the code. Chinese
 * readers get the stone's own name alongside it rather than instead of it.
 */
const rows = MINERALS.map((m) => {
  const gloss = MINERALS_ZH[m.name];
  return {
    name: m.name,
    label: lang === 'zh' ? gloss.label : m.name,
    hex: m.hex,
    origin: lang === 'zh' ? gloss.origin : m.origin,
    symbolism: lang === 'zh' ? gloss.symbolism : m.symbolism,
    usage: lang === 'zh' ? gloss.usage : m.usage,
    onSheet: ratio(m.hex, SHEET.base),
    grade: rating(Number.parseFloat(ratio(m.hex, SHEET.base))),
  };
});

/**
 * The sets after the minerals, as data.
 *
 * A set is a heading, a lede and its families; what a family carries (an
 * origin, a meaning, a use) is optional, because the sets do not all have the
 * same provenance and the page should not pretend they do. Adding a set is an
 * entry here and its strings in `ui.ts`, not new markup.
 *
 * Swatches read the `--color-<name>` token, never a hex, and every figure is
 * measured on the sheet exactly as the minerals' are.
 */
interface Family {
  name: string;
  label: string;
  token: string;
  hex: string;
  fields: { term: string; value: string }[];
  onSheet: string;
  grade: string;
}

interface PaletteSet {
  id: string;
  eyebrow: string;
  note: string;
  heading: string;
  lede: string;
  /** A compact grid for sets that carry colour and nothing else. */
  compact: boolean;
  families: Family[];
}

const measured = (hex: string) => ({
  onSheet: ratio(hex, SHEET.base),
  grade: rating(Number.parseFloat(ratio(hex, SHEET.base))),
});

const SETS: PaletteSet[] = [
  {
    id: 'heritage',
    eyebrow: t('minerals.heritage_eyebrow'),
    note: t('minerals.heritage_note'),
    heading: t('minerals.heritage_heading'),
    lede: t('minerals.heritage_lede'),
    compact: false,
    families: HERITAGE.map((h) => {
      const gloss = HERITAGE_ZH[h.name];
      const zh = lang === 'zh';
      return {
        name: h.name,
        label: zh ? gloss.label : h.name,
        token: colorVar(h.name),
        hex: h.darkHex,
        fields: [
          { term: t('minerals.key_means'), value: zh ? gloss.symbolism : h.symbolism },
          { term: t('minerals.key_named'), value: zh ? gloss.origin : h.origin },
          { term: t('minerals.key_used'), value: zh ? gloss.usage : h.usage },
        ],
        ...measured(h.darkHex),
      };
    }),
  },
  {
    id: 'experimental',
    eyebrow: t('minerals.experimental_eyebrow'),
    note: t('minerals.experimental_note'),
    heading: t('minerals.experimental_heading'),
    lede: t('minerals.experimental_lede'),
    compact: true,
    families: EXPERIMENTAL.map((e) => ({
      name: e.name,
      label: lang === 'zh' ? EXPERIMENTAL_ZH[e.name] : e.name,
      token: colorVar(e.name),
      hex: e.darkHex,
      fields: [],
      ...measured(e.darkHex),
    })),
  },
];
---

<BaseLayout
  title={t('minerals.title')}
  description={t('minerals.description')}
  path="/minerals"
  lang={lang}
  sheet="05 / 06"
>
  <PageHeader
    eyebrow={t('minerals.eyebrow')}
    title={t('minerals.title')}
    lede={t('minerals.lede')}
    note={t('minerals.note')}
  />

  <section class="section reveal" aria-labelledby="why-heading">
    <Panel fig={t('minerals.why_fig')}>
      <h2 id="why-heading">{t('minerals.why_heading')}</h2>
      <p>
        {t('minerals.why_p1_before')}<em>{t('minerals.why_p1_primary')}</em>{t(
          'minerals.why_p1_sep1',
        )}<em>{t('minerals.why_p1_secondary')}</em>{t('minerals.why_p1_sep2')}<em
          >{t('minerals.why_p1_accent')}</em
        >{t('minerals.why_p1_mid')}<a
          href={MZIZI}
          target="_blank"
          rel="noopener noreferrer">{t('minerals.why_p1_link')}</a
        >{t('minerals.why_p1_after')}
      </p>
      <p>{t('minerals.why_p2')}</p>
      <p>
        {t('minerals.why_p3_before')}<em>{t('minerals.why_p3_nyuchi')}</em>{t(
          'minerals.why_p3_mid',
        )}<em>{t('minerals.why_p3_ubuntu')}</em>{t('minerals.why_p3_after')}<a
          href={MZIZI}
          target="_blank"
          rel="noopener noreferrer">mzizi.dev</a
        >{t('minerals.why_p3_end')}
      </p>
    </Panel>
  </section>

  <section class="section reveal" aria-labelledby="key-heading">
    <div class="section-head">
      <p class="eyebrow is-open">{t('minerals.key_eyebrow')}</p>
      <span class="margin-note">{t('minerals.key_note')}</span>
    </div>
    <h2 class="visually-hidden" id="key-heading">{t('minerals.key_heading')}</h2>

    <ol class="key">
      {
        rows.map((m, i) => (
          <li>
            <Panel as="article" class="key__item" mineral={m.name}>
              <span class="key__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="key__swatch" aria-hidden="true" />

              <div class="key__body">
                <h3>
                  {m.label}
                  {m.label !== m.name && (
                    <span class="key__token" lang="en">
                      {m.name}
                    </span>
                  )}
                </h3>
                <dl>
                  <dt>{t('minerals.key_means')}</dt>
                  <dd>{m.symbolism}</dd>
                  <dt>{t('minerals.key_mined')}</dt>
                  <dd>{m.origin}</dd>
                  <dt>{t('minerals.key_used')}</dt>
                  <dd>{m.usage}</dd>
                </dl>
              </div>

              <div class="key__figures">
                <span class="key__hex">{m.hex}</span>
                <span class="key__ratio">
                  {m.onSheet} <span class="key__grade">{m.grade}</span>
                </span>
              </div>
            </Panel>
          </li>
        ))
      }
    </ol>
  </section>

  {
    SETS.map((set) => (
      <section class="section reveal" aria-labelledby={`${set.id}-heading`}>
        <div class="section-head">
          <p class="eyebrow is-open">{set.eyebrow}</p>
          <span class="margin-note">{set.note}</span>
        </div>
        <h2 class="section-title sheet-h2" id={`${set.id}-heading`}>{set.heading}</h2>
        <p class="lede">{set.lede}</p>

        <ol class:list={['key', set.compact && 'key--compact']}>
          {set.families.map((f, i) => (
            <li>
              <Panel as="article" class="key__item" style={`--mineral: ${f.token}`}>
                {!set.compact && <span class="key__index">{String(i + 1).padStart(2, '0')}</span>}
                <span class="key__swatch" aria-hidden="true" />

                <div class="key__body">
                  <h3>
                    {f.label}
                    {f.label !== f.name && (
                      <span class="key__token" lang="en">
                        {f.name}
                      </span>
                    )}
                  </h3>
                  {f.fields.length > 0 && (
                    <dl>
                      {f.fields.map((field) => (
                        <>
                          <dt>{field.term}</dt>
                          <dd>{field.value}</dd>
                        </>
                      ))}
                    </dl>
                  )}
                </div>

                <div class="key__figures">
                  <span class="key__hex">{f.hex}</span>
                  <span class="key__ratio">
                    {f.onSheet} <span class="key__grade">{f.grade}</span>
                  </span>
                </div>
              </Panel>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <section class="section reveal" aria-labelledby="a11y-heading">
    <Panel fig={t('minerals.a11y_fig')}>
      <h2 id="a11y-heading">{t('minerals.a11y_heading')}</h2>
      <p>
        {t('minerals.a11y_p1_before')}<code>{SHEET.base}</code>{t('minerals.a11y_p1_after')}
      </p>
      <p>
        {t('minerals.a11y_p2_before')}<a href={MZIZI} target="_blank" rel="noopener noreferrer"
          >mzizi.dev</a
        >{t('minerals.a11y_p2_after')}
      </p>
      <p>
        {t('minerals.a11y_p3_before')}<em>{t('minerals.a11y_p3_nontext')}</em>{t(
          'minerals.a11y_p3_mid',
        )}<code>aria-hidden</code>{t('minerals.a11y_p3_after')}
      </p>
    </Panel>
  </section>
</BaseLayout>

