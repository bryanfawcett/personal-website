---
/**
 * The rail, explained — in whichever language it is asked for.
 *
 * The seven segments running down the binding edge are the site's only
 * saturated colour, and nowhere said what they were. Every figure on this
 * page — the contrast ratios especially — is computed at build time from the
 * same tokens the rail draws with, so the page cannot drift from the rail.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { MINERALS } from '../brand/minerals.js';
import { SHEET } from '../brand/tokens.js';
import { rating, ratio } from '../brand/contrast.js';
import { MINERALS_ZH } from '../data/minerals-i18n.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const MZIZI = 'https://mzizi.dev';

/**
 * Measured against the sheet the rail is actually drawn on.
 *
 * The token name is the mineral's identity and stays in Latin script in both
 * languages — it is what `--mineral-cobalt` is called in the code. Chinese
 * readers get the stone's own name alongside it rather than instead of it.
 */
const rows = MINERALS.map((m) => {
  const gloss = MINERALS_ZH[m.name];
  return {
    name: m.name,
    label: lang === 'zh' ? gloss.label : m.name,
    hex: m.hex,
    origin: lang === 'zh' ? gloss.origin : m.origin,
    symbolism: lang === 'zh' ? gloss.symbolism : m.symbolism,
    usage: lang === 'zh' ? gloss.usage : m.usage,
    onSheet: ratio(m.hex, SHEET.base),
    grade: rating(Number.parseFloat(ratio(m.hex, SHEET.base))),
  };
});
---

<BaseLayout
  title={t('minerals.title')}
  description={t('minerals.description')}
  path="/minerals"
  lang={lang}
  sheet="05 / 06"
>
  <PageHeader
    eyebrow={t('minerals.eyebrow')}
    title={t('minerals.title')}
    lede={t('minerals.lede')}
    note={t('minerals.note')}
  />

  <section class="section reveal" aria-labelledby="why-heading">
    <Panel fig={t('minerals.why_fig')}>
      <h2 id="why-heading">{t('minerals.why_heading')}</h2>
      <p>
        {t('minerals.why_p1_before')}<em>{t('minerals.why_p1_primary')}</em>{t(
          'minerals.why_p1_sep1',
        )}<em>{t('minerals.why_p1_secondary')}</em>{t('minerals.why_p1_sep2')}<em
          >{t('minerals.why_p1_accent')}</em
        >{t('minerals.why_p1_mid')}<a
          href={MZIZI}
          target="_blank"
          rel="noopener noreferrer">{t('minerals.why_p1_link')}</a
        >{t('minerals.why_p1_after')}
      </p>
      <p>{t('minerals.why_p2')}</p>
      <p>
        {t('minerals.why_p3_before')}<em>{t('minerals.why_p3_nyuchi')}</em>{t(
          'minerals.why_p3_mid',
        )}<em>{t('minerals.why_p3_ubuntu')}</em>{t('minerals.why_p3_after')}<a
          href={MZIZI}
          target="_blank"
          rel="noopener noreferrer">mzizi.dev</a
        >{t('minerals.why_p3_end')}
      </p>
    </Panel>
  </section>

  <section class="section reveal" aria-labelledby="key-heading">
    <div class="section-head">
      <p class="eyebrow is-open">{t('minerals.key_eyebrow')}</p>
      <span class="margin-note">{t('minerals.key_note')}</span>
    </div>
    <h2 class="visually-hidden" id="key-heading">{t('minerals.key_heading')}</h2>

    <ol class="key">
      {
        rows.map((m, i) => (
          <li>
            <Panel as="article" class="key__item" style={`--m: var(--mineral-${m.name})`}>
              <span class="key__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="key__swatch" aria-hidden="true" />

              <div class="key__body">
                <h3>
                  {m.label}
                  {m.label !== m.name && (
                    <span class="key__token" lang="en">
                      {m.name}
                    </span>
                  )}
                </h3>
                <dl>
                  <dt>{t('minerals.key_means')}</dt>
                  <dd>{m.symbolism}</dd>
                  <dt>{t('minerals.key_mined')}</dt>
                  <dd>{m.origin}</dd>
                  <dt>{t('minerals.key_used')}</dt>
                  <dd>{m.usage}</dd>
                </dl>
              </div>

              <div class="key__figures">
                <span class="key__hex">{m.hex}</span>
                <span class="key__ratio">
                  {m.onSheet} <span class="key__grade">{m.grade}</span>
                </span>
              </div>
            </Panel>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section reveal" aria-labelledby="a11y-heading">
    <Panel fig={t('minerals.a11y_fig')}>
      <h2 id="a11y-heading">{t('minerals.a11y_heading')}</h2>
      <p>
        {t('minerals.a11y_p1_before')}<code>{SHEET.base}</code>{t('minerals.a11y_p1_after')}
      </p>
      <p>
        {t('minerals.a11y_p2_before')}<a href={MZIZI} target="_blank" rel="noopener noreferrer"
          >mzizi.dev</a
        >{t('minerals.a11y_p2_after')}
      </p>
      <p>
        {t('minerals.a11y_p3_before')}<em>{t('minerals.a11y_p3_nontext')}</em>{t(
          'minerals.a11y_p3_mid',
        )}<code>aria-hidden</code>{t('minerals.a11y_p3_after')}
      </p>
    </Panel>
  </section>
</BaseLayout>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .key {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    counter-reset: mineral;
  }

  .key :global(.key__item) {
    display: grid;
    grid-template-columns: auto 4px 1fr auto;
    align-items: start;
    gap: 0 1.25rem;
    padding: 1.5rem 1.625rem;
  }

  .key__index {
    font-family: var(--mono);
    font-size: var(--label-lg);
    font-weight: var(--label-weight);
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    padding-block-start: 0.35rem;
  }

  /* The segment itself, lifted off the rail and stood on end. */
  .key__swatch {
    align-self: stretch;
    min-height: 3.5rem;
    background: var(--m);
  }

  /*
   * Ink, not the mineral.
   *
   * The 4px swatch stood on end to the left of this heading is the mineral,
   * full-strength and unmissable; setting the name in the same colour added
   * nothing and cost a great deal — sodalite measured Lc 24.6, and a page
   * whose subject is contrast cannot print its own key illegibly.
   */
  .key__body h3 {
    font-size: 1.375rem;
    text-transform: capitalize;
    color: var(--ink);
  }

  .key__body dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin-block-start: 0.625rem;
  }

  .key__body dt {
    font-family: var(--mono);
    /* 10px floor on label text. */
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-block-start: 0.3rem;
  }

  .key__body dd {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--ink-body);
  }

  .key__figures {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.1em;
    text-align: end;
  }

  /* Same reasoning as the heading: the swatch is the colour, this is its name. */
  .key__hex {
    color: var(--ink);
    text-transform: uppercase;
  }

  .key__ratio {
    color: var(--ink-soft);
  }

  .key__grade {
    display: block;
    margin-block-start: 2px;
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .panel a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 44rem) {
    .key :global(.key__item) {
      grid-template-columns: auto 4px 1fr;
      row-gap: 1rem;
      padding: 1.25rem;
    }

    .key__figures {
      grid-column: 3;
      align-items: flex-start;
      text-align: start;
    }

    .key__grade {
      display: inline;
      margin-inline-start: 0.5rem;
    }
  }

  /*
   * The token name, carried alongside the Chinese name of the stone: it is
   * what the custom property is called, so it stays Latin and mono and is
   * marked `lang="en"` so a screen reader does not read it as Chinese.
   */
  .key__token {
    margin-inline-start: 0.5rem;
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
