---
/** The commission sheet, in whichever language it is asked for. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { PROFILE } from '../data/profile.js';
import { bookingTopics } from '../data/booking.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('book.title')}
  description={t('book.description')}
  path="/book"
  lang={lang}
  sheet="06 / 06"
>
  <PageHeader
    eyebrow={t('book.eyebrow')}
    title={t('book.title')}
    lede={t('book.lede')}
    note={t('book.note')}
  />

  <section class="section reveal" aria-labelledby="topics-heading">
    <p class="eyebrow is-open">{t('book.topics_eyebrow')}</p>
    <h2 class="visually-hidden" id="topics-heading">{t('book.topics_heading')}</h2>

    <ul class="topics">
      {
        bookingTopics(lang).map((topic) => (
          <Panel as="li" mineral={topic.mineral}>
            <h3>{topic.title}</h3>
            <p>{topic.detail}</p>
          </Panel>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="scheduler-heading">
    <p class="eyebrow is-open">{t('book.scheduling_eyebrow')}</p>
    <h2 class="visually-hidden" id="scheduler-heading">{t('book.scheduling_heading')}</h2>

    <div class="scheduler">
      <!--
        Cal.com is loaded only when the visitor asks for it. A third-party
        scheduler embed on every page load is a tracker the reader did not
        request, and it is the heaviest thing on the page.
      -->
      <div id="cal-embed" class="scheduler__embed" data-cal-link="bryanfawcett"></div>
      <button id="cal-load" class="btn" type="button" data-error={t('book.error')}>
        {t('book.load')}
      </button>
      <p class="scheduler__fallback">
        {t('book.fallback')} <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Cal.com's embed queue pattern, reproduced by hand.
   *
   * A plain `<script src="…/embed.js">` — what this used to be — loads the
   * library and stops there; nothing tells it to render anything. embed.js
   * has to be *told* to draw an inline calendar via `Cal('inline', …)`, and
   * that call has to be queued before the library exists so it runs the
   * moment it's ready. `window.Cal` starts as this stub — a function that
   * only pushes its arguments onto a queue and, on its first call, injects
   * the real script — and embed.js replays that queue once it loads.
   *
   * The full snippet Cal.com's own generator hands out also supports naming
   * multiple embed instances; this page only ever creates one, so that part
   * is dropped.
   */
  interface CalApi {
    (...args: unknown[]): void;
    q: unknown[][];
  }

  function loadCal(embedJsUrl: string): CalApi {
    const api = ((...args: unknown[]) => {
      api.q.push(args);
    }) as CalApi;
    api.q = [];

    /*
     * embed.js looks for its queue on `window.Cal`, not on whatever variable
     * happens to hold the return value here — it is a global contract, not a
     * function argument. Skipping this line leaves `window.Cal` undefined,
     * and the real script throws "Cal is not defined. This shouldn't
     * happen" the moment it loads and goes looking for it.
     */
    (window as Window & { Cal?: CalApi }).Cal = api;

    const script = document.createElement('script');
    script.src = embedJsUrl;
    script.async = true;
    document.head.appendChild(script);

    return api;
  }

  const button = document.getElementById('cal-load');
  const embed = document.getElementById('cal-embed');

  button?.addEventListener(
    'click',
    () => {
      if (!embed) return;

      button.remove();
      embed.dataset['state'] = 'loading';

      const Cal = loadCal('https://app.cal.com/embed/embed.js');

      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', {
        elementOrSelector: '#cal-embed',
        calLink: 'bryanfawcett',
        config: { layout: 'month_view' },
      });
      // linkReady / linkFailed fire once the calendar iframe itself has
      // loaded (or failed to) — the embed.js script's own load event only
      // means the library arrived, not that a calendar is showing yet.
      Cal('on', {
        action: 'linkReady',
        callback: () => {
          embed.dataset['state'] = 'ready';
        },
      });
      Cal('on', {
        action: 'linkFailed',
        callback: () => {
          embed.dataset['state'] = 'error';
          // Localized in the template: a `<script>` in an .astro file is a
          // separate module and cannot read a frontmatter value directly.
          embed.textContent =
            button.dataset['error'] ?? 'The scheduler could not load. Email bryan@nyuchi.com instead.';
        },
      });
    },
    { once: true },
  );
</script>

