---
/**
 * One adventure, in whichever language it was asked for.
 *
 * Server-rendered, like the list. The body arrives as Portable Text and is
 * turned into the site's own markup by `src/sanity/portable-text.ts` — nothing
 * here invents a visual treatment the templates do not already have.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { BLOG_CACHE_CONTROL, groq } from '../sanity/client.js';
import { ADVENTURE_EN, ADVENTURE_ZH } from '../sanity/queries.js';
import { resolveImage } from '../sanity/image.js';
import { renderBody } from '../sanity/portable-text.js';
import { DEFAULT_MINERAL, type Adventure } from '../sanity/types.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';
import { keyedTo } from '../brand/minerals.js';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);

const result = await groq<Adventure | null>(lang === 'zh' ? ADVENTURE_ZH : ADVENTURE_EN, { slug });
const adventure = result.ok ? result.data : null;

/*
 * Three outcomes, three status codes.
 *
 * A missing adventure is a real 404. An unreachable Sanity is a 503 with
 * Retry-After — telling a crawler "gone" when the content service is merely
 * down is how a blog quietly drops out of an index. Only a found adventure is
 * cacheable; the other two must not be held at the edge.
 */
if (!result.ok) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (!adventure) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', BLOG_CACHE_CONTROL);
}

const listPath = localizePath('/adventures', lang);

/*
 * The two languages of *this* adventure, for hreflang and the switcher.
 *
 * An untranslated one lists English only, so nothing claims a Chinese version
 * exists. The switcher then falls back to the Chinese list, which is a real
 * page and a sensible place to land.
 */
const alternates: Partial<Record<Lang, string>> = adventure
  ? lang === 'en'
    ? {
        en: `/adventures/${adventure.slug}`,
        ...(adventure.translation ? { zh: `/zh/adventures/${adventure.translation.slug}` } : {}),
      }
    : {
        zh: `/zh/adventures/${adventure.slug}`,
        ...(adventure.original ? { en: `/adventures/${adventure.original.slug}` } : {}),
      }
  : {};

const dateFormat = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-Hans-CN' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const cover = adventure ? resolveImage(adventure.cover, { width: 900, aspect: 16 / 9 }) : null;
const body = adventure ? renderBody(adventure.body) : '';
---

<BaseLayout
  title={adventure ? adventure.title : result.ok ? t('adv.missing_title') : t('adv.unavailable_title')}
  description={adventure?.excerpt ?? t('adv.description')}
  path="/adventures"
  lang={lang}
  {...(adventure ? { alternates } : {})}
  sheet="03 / 06"
  ogType="article"
>
  {
    adventure ? (
      <>
        <PageHeader
          eyebrow={dateFormat.format(new Date(adventure.publishedAt))}
          title={adventure.title}
          lede={adventure.excerpt}
          note={adventure.place}
        />

        <article
          class="section reveal adventure"
          style={keyedTo(adventure.mineral ?? DEFAULT_MINERAL)}
        >
          <span class="adventure__bar" aria-hidden="true" />

          {cover && (
            <figure class="adventure__cover">
              <span class="panel__rule" aria-hidden="true" />
              <img
                src={cover.src}
                srcset={cover.srcset}
                width={cover.width}
                height={cover.height}
                alt={cover.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          )}

          {/* Sanitised at the source: the body is authored in the Studio, and
              Portable Text carries structure rather than markup, so nothing a
              writer types can reach this as raw HTML. */}
          <div class="adventure__body prose" set:html={body} />
        </article>
      </>
    ) : (
      <>
        <PageHeader
          eyebrow={t('adv.eyebrow')}
          title={result.ok ? t('adv.missing_title') : t('adv.unavailable_title')}
          lede={result.ok ? t('adv.missing_body') : t('adv.unavailable_body')}
          note={t('adv.note')}
        />
        <Panel class="adventure__notice">
          <p>
            <a class="btn" href={listPath}>
              {t('adv.back')}
            </a>
          </p>
        </Panel>
      </>
    )
  }

  {
    adventure && (
      <p class="adventure__back">
        <a class="btn is-ghost" href={listPath}>
          {t('adv.back')}
        </a>
      </p>
    )
  }
</BaseLayout>

