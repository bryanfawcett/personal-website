---
/**
 * One adventure, in whichever language it was asked for.
 *
 * Server-rendered, like the list. The body arrives as Portable Text and is
 * turned into the site's own markup by `src/sanity/portable-text.ts` — nothing
 * here invents a visual treatment the templates do not already have.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { BLOG_CACHE_CONTROL, groq } from '../sanity/client.js';
import { ADVENTURE_EN, ADVENTURE_ZH } from '../sanity/queries.js';
import { resolveImage } from '../sanity/image.js';
import { renderBody } from '../sanity/portable-text.js';
import { DEFAULT_MINERAL, type Adventure } from '../sanity/types.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);

const result = await groq<Adventure | null>(lang === 'zh' ? ADVENTURE_ZH : ADVENTURE_EN, { slug });
const adventure = result.ok ? result.data : null;

/*
 * Three outcomes, three status codes.
 *
 * A missing adventure is a real 404. An unreachable Sanity is a 503 with
 * Retry-After — telling a crawler "gone" when the content service is merely
 * down is how a blog quietly drops out of an index. Only a found adventure is
 * cacheable; the other two must not be held at the edge.
 */
if (!result.ok) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (!adventure) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', BLOG_CACHE_CONTROL);
}

const listPath = localizePath('/adventures', lang);

/*
 * The two languages of *this* adventure, for hreflang and the switcher.
 *
 * An untranslated one lists English only, so nothing claims a Chinese version
 * exists. The switcher then falls back to the Chinese list, which is a real
 * page and a sensible place to land.
 */
const alternates: Partial<Record<Lang, string>> = adventure
  ? lang === 'en'
    ? {
        en: `/adventures/${adventure.slug}`,
        ...(adventure.translation ? { zh: `/zh/adventures/${adventure.translation.slug}` } : {}),
      }
    : {
        zh: `/zh/adventures/${adventure.slug}`,
        ...(adventure.original ? { en: `/adventures/${adventure.original.slug}` } : {}),
      }
  : {};

const dateFormat = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-Hans-CN' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const cover = adventure ? resolveImage(adventure.cover, { width: 900, aspect: 16 / 9 }) : null;
const body = adventure ? renderBody(adventure.body) : '';
---

<BaseLayout
  title={adventure ? adventure.title : result.ok ? t('adv.missing_title') : t('adv.unavailable_title')}
  description={adventure?.excerpt ?? t('adv.description')}
  path="/adventures"
  lang={lang}
  {...(adventure ? { alternates } : {})}
  sheet="03 / 06"
  ogType="article"
>
  {
    adventure ? (
      <>
        <PageHeader
          eyebrow={dateFormat.format(new Date(adventure.publishedAt))}
          title={adventure.title}
          lede={adventure.excerpt}
          note={adventure.place}
        />

        <article
          class="section reveal adventure"
          style={`--panel-mineral: var(--mineral-${adventure.mineral ?? DEFAULT_MINERAL})`}
        >
          <span class="adventure__bar" aria-hidden="true" />

          {cover && (
            <figure class="adventure__cover">
              <span class="panel__rule" aria-hidden="true" />
              <img
                src={cover.src}
                srcset={cover.srcset}
                width={cover.width}
                height={cover.height}
                alt={cover.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          )}

          {/* Sanitised at the source: the body is authored in the Studio, and
              Portable Text carries structure rather than markup, so nothing a
              writer types can reach this as raw HTML. */}
          <div class="adventure__body prose" set:html={body} />
        </article>
      </>
    ) : (
      <>
        <PageHeader
          eyebrow={t('adv.eyebrow')}
          title={result.ok ? t('adv.missing_title') : t('adv.unavailable_title')}
          lede={result.ok ? t('adv.missing_body') : t('adv.unavailable_body')}
          note={t('adv.note')}
        />
        <Panel class="adventure__notice">
          <p>
            <a class="btn" href={listPath}>
              {t('adv.back')}
            </a>
          </p>
        </Panel>
      </>
    )
  }

  {
    adventure && (
      <p class="adventure__back">
        <a class="btn is-ghost" href={listPath}>
          {t('adv.back')}
        </a>
      </p>
    )
  }
</BaseLayout>

<style>
  .adventure {
    position: relative;
  }

  /* The adventure's mineral, as a rule under the header — the one hit of colour. */
  .adventure__bar {
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-block-end: 2rem;
    background: var(--panel-mineral);
  }

  .adventure__cover {
    position: relative;
    margin-block-end: 2.5rem;
  }

  .adventure__cover img {
    width: 100%;
    height: auto;
    filter: grayscale(0.45) contrast(1.04);
  }

  /*
   * The body column.
   *
   * `--measure` is the token, not a number picked here — Cormorant runs about
   * 6.8px per character and a column that looks right by eye measures far past
   * a comfortable line.
   */
  .adventure__body {
    max-width: var(--measure);
  }

  .adventure__body :global(p),
  .adventure__body :global(ul),
  .adventure__body :global(ol) {
    margin-block-end: 1.125rem;
    font-size: 1.125rem;
    line-height: 1.62;
    color: var(--ink-body);
  }

  .adventure__body :global(h2) {
    margin-block: 2.25rem 0.75rem;
    font-size: 1.5rem;
  }

  .adventure__body :global(h3) {
    margin-block: 1.75rem 0.5rem;
    font-size: 1.1875rem;
  }

  .adventure__body :global(ul),
  .adventure__body :global(ol) {
    padding-inline-start: 1.25rem;
  }

  .adventure__body :global(li) {
    margin-block-end: 0.375rem;
  }

  /*
   * The pull quote, matching the treatment on the origins sheet: a mineral
   * rule down the inside edge and a lighter, larger serif. Uses the
   * adventure's own mineral rather than a fixed one, so a quote belongs to
   * the piece it sits in.
   */
  .adventure__body :global(blockquote) {
    max-width: var(--measure);
    margin-block: 2.5rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 3px solid var(--panel-mineral);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.625rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }

  .adventure__body :global(blockquote p) {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    margin-block-end: 0;
  }

  .adventure__body:lang(zh) :global(blockquote) {
    font-family: var(--cjk);
    line-height: 1.6;
    text-wrap: normal;
  }

  .adventure__body :global(a) {
    color: var(--mineral-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * Images inside the body are framed like every other container — hairline,
   * corner brackets, ruled caption. Styles are :global because the markup is
   * built as a string by the Portable Text renderer, so Astro's scoping
   * attribute never lands on it.
   */
  .adventure__body :global(.adventure__figure) {
    position: relative;
    margin-block: 2rem;
    padding: 0.5rem;
  }

  .adventure__body :global(.adventure__figure img) {
    width: 100%;
    height: auto;
    filter: grayscale(0.45) contrast(1.04);
  }

  .adventure__body :global(figcaption) {
    margin-block-start: 0.625rem;
    padding-block-start: 0.5rem;
    border-block-start: 1px solid var(--ink-hair);
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .adventure__notice {
    padding: 2rem;
  }

  .adventure__back {
    margin-block-start: 3rem;
  }

  .adventure__body:lang(zh) :global(p),
  .adventure__body:lang(zh) :global(li) {
    line-height: 1.8;
  }

  .adventure__body:lang(zh) :global(figcaption) {
    font-family: var(--cjk-mono);
    letter-spacing: 0.1em;
    text-transform: none;
  }
</style>
