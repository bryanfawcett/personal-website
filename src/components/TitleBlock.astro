---
/**
 * The title block — the footer, as a drawing sheet has one.
 *
 * Project, draughtsman, sheet number and revision, ruled into cells, with the
 * site navigation carried in the bottom strip where a real sheet carries
 * its references.
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV, PROFILE, profileInLang, socialsInLang } from '../data/profile.js';
import { localizePath } from '../i18n/routing.js';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  sheet?: string;
  lang?: Lang;
  /** Language-neutral path, so the switcher can find this page's counterpart. */
  path?: string;
}

const { sheet = '01 / 04', lang = defaultLang, path = '/' } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);
const year = new Date().getFullYear();
---

<footer class="title-block" aria-label={t('tb.label')}>
  <div class="tb-cell tb-name">
    <span class="k">{t('tb.project')}</span>
    <span class="v">{PROFILE.name} — {profile.title}</span>
  </div>
  <div class="tb-cell">
    <span class="k">{t('tb.drawn_by')}</span>
    <span class="v">B.D.F.</span>
  </div>
  <div class="tb-cell">
    <span class="k">{t('tb.sheet')}</span>
    <span class="v">{sheet}</span>
  </div>
  <div class="tb-cell">
    <span class="k">{t('tb.rev')}</span>
    <span class="v">A — {year}</span>
  </div>

  <div class="tb-foot">
    <nav aria-label={t('nav.footer')}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={localizePath(item.href, lang)}>{t(item.labelKey)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="tb-social">
      {
        socialsInLang(lang).map((social) => (
          <li>
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>

    <span class="tb-lang"><LanguageSwitcher lang={lang} path={path} /></span>

    <span class="tb-copy">© {year} {PROFILE.name}</span>
  </div>
</footer>

<style>
  .title-block {
    margin-block: 4rem 3rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    background: var(--sheet-wash);
    border: 1px solid var(--ink-faint);
  }

  .tb-cell {
    padding: 0.75rem 1rem;
    border-inline-end: 1px solid var(--ink-faint);
    font-family: var(--mono);
  }

  .tb-cell:nth-child(4) {
    border-inline-end: none;
  }

  .tb-cell .k {
    display: block;
    margin-block-end: 4px;
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .tb-cell .v {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .tb-name {
    font-family: var(--serif);
  }

  .tb-name .v {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .tb-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.5rem 1rem;
    border-block-start: 1px solid var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .tb-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .tb-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color 0.2s ease;
  }

  .tb-foot a:hover {
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .title-block {
      grid-template-columns: 1fr 1fr;
    }

    .tb-name {
      grid-column: 1 / -1;
      border-inline-end: none;
    }

    .tb-cell:nth-child(3) {
      border-inline-end: none;
    }
  }
</style>
