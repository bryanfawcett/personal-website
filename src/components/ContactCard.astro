---
/**
 * The contact card: portrait, particulars, and a QR that books a call.
 *
 * The QR opens the 30-minute booking page, because booking is the one action
 * the site asks for; the vCard is a download beneath it. It is rendered to SVG
 * at build time; nothing about it ships as JavaScript.
 */
import Portrait from './Portrait.astro';
import { bookingQr } from '../brand/qr.js';
import { PROFILE, profileInLang } from '../data/profile.js';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  /** Rendered portrait width. */
  width?: number;
  /** Above the fold — skip lazy loading on the portrait. */
  eager?: boolean;
  class?: string | undefined;
  lang?: Lang;
}

const { width = 152, eager = false, class: className, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);

/*
 * The vCard behind "Download .vcf" stays English in both languages: it is one
 * canonical contact record that ends up in a stranger's address book, and a
 * card that differs by the page it came from is a duplicate contact waiting
 * to happen. The QR's booking link is the same in both, for the same reason.
 */
const qrDark = await bookingQr('dark');
const qrLight = await bookingQr('light');
---

<div class:list={['card', className]}>
  <Portrait width={width} caption={t('card.fig')} eager={eager} lang={lang} />

  <div class="card__body">
    <p class="card__name">{PROFILE.name}</p>
    <p class="card__title">{profile.title}</p>

    <ul class="card__roles">
      {
        profile.roles.map((role) => (
          <li>
            <span class="card__role">{role.title}</span>
            <span class="card__org">{role.org}</span>
          </li>
        ))
      }
    </ul>

    <a class="card__email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
  </div>

  <div class="card__scan">
    {/* Decorative: the page's own booking button goes to the same place. */}
    {/* One code per theme; tokens show the one that matches the page. */}
    <div class="card__qr card__qr--dark" aria-hidden="true" set:html={qrDark} />
    <div class="card__qr card__qr--light" aria-hidden="true" set:html={qrLight} />
    <p class="card__hint">{t('card.scan')}</p>
    <a class="card__download" href="/bryan-fawcett.vcf" download>{t('card.download')}</a>
  </div>
</div>

