---
/**
 * The contact card: portrait, particulars, and a QR that saves the contact.
 *
 * The QR carries the whole vCard, not a link to one, so it works with no
 * network — which is the case that matters, standing in a room at a workshop.
 * It is rendered to SVG at build time; nothing about it ships as JavaScript.
 */
import Portrait from './Portrait.astro';
import { vcardQr } from '../brand/vcard.js';
import { PROFILE, profileInLang } from '../data/profile.js';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  /** Rendered portrait width. */
  width?: number;
  /** Above the fold — skip lazy loading on the portrait. */
  eager?: boolean;
  class?: string | undefined;
  lang?: Lang;
}

const { width = 152, eager = false, class: className, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);

/*
 * The vCard itself stays English in both languages: it is one canonical
 * contact record that ends up in a stranger's address book, and a card that
 * says something different depending on which page it was scanned from is a
 * duplicate contact waiting to happen.
 */
const qr = await vcardQr();
---

<div class:list={['card', className]}>
  <Portrait width={width} caption={t('card.fig')} eager={eager} lang={lang} />

  <div class="card__body">
    <p class="card__name">{PROFILE.name}</p>
    <p class="card__title">{profile.title}</p>

    <ul class="card__roles">
      {
        profile.roles.map((role) => (
          <li>
            <span class="card__role">{role.title}</span>
            <span class="card__org">{role.org}</span>
          </li>
        ))
      }
    </ul>

    <a class="card__email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
  </div>

  <div class="card__scan">
    {/* Decorative: the same details are in text above, and in the link below. */}
    <div class="card__qr" aria-hidden="true" set:html={qr} />
    <p class="card__hint">{t('card.scan')}</p>
    <a class="card__download" href="/bryan-fawcett.vcf" download>{t('card.download')}</a>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2rem 2.5rem;
  }

  .card__body {
    flex: 1 1 14rem;
    min-width: 0;
  }

  .card__name {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .card__title {
    margin-block-start: 2px;
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .card__roles {
    margin-block-start: 1.125rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card__roles li {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--ink-faint);
  }

  .card__role {
    display: block;
    font-size: 1rem;
    color: var(--ink);
  }

  .card__org {
    display: block;
    font-family: var(--mono);
    /* 10px floor on label text. */
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .card__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block-start: 0.75rem;
    border-block-end: 1.5px dashed var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .card__scan {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }

  /*
   * The QR is drawn in ink on nothing, so it needs its own quiet ground: a
   * code over the blueprint ruling is a code a phone will not lock onto.
   */
  .card__qr {
    width: 11rem;
    padding: 0.625rem;
    background: var(--sheet-deep);
    border: 1px solid var(--ink-faint);
  }

  .card__qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .card__hint,
  .card__download {
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .card__download {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-block-end: 1px dashed var(--ink-soft);
  }

  .card__download:hover {
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .card {
      gap: 1.5rem;
    }

    .card__scan {
      width: 100%;
    }
  }
</style>
