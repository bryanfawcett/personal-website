---
/**
 * The contact card: portrait, particulars, and a QR that books a call.
 *
 * The markup is Rust (`tools/components/src/contact_card.rs`, rendered by `pnpm fragments`).
 * Astro supplies what only the build knows: the content-hashed portrait URLs and the two QR
 * SVGs from `src/brand/qr.ts`, so the codes stay exactly what they were.
 *
 * The vCard behind "Download .vcf" stays English in both languages: it is one canonical
 * contact record that ends up in a stranger's address book. The QR's booking link is the
 * same in both, for the same reason.
 */
import { getImage } from 'astro:assets';
import source from '../assets/bryan-fawcett.png';
import { bookingQr } from '../brand/qr.js';
import { defaultLang, type Lang } from '../i18n/ui.js';
import { fill, fillRaw, fragment } from './fragments.js';

interface Props {
  /** Rendered portrait width. */
  width?: number;
  /** Above the fold — skip lazy loading on the portrait. */
  eager?: boolean;
  class?: string | undefined;
  lang?: Lang;
}

const { width = 152, eager = false, class: className, lang = defaultLang } = Astro.props;

if (className !== 'connect__card' || eager || width !== 152) {
  throw new Error('ContactCard: no Rust fragment for this variant; add one in tools/components/src/bin/render.rs');
}
const height = Math.round((width * source.height) / source.width);
const img = await getImage({ src: source, width, height, densities: [1, 2] });
const html = fillRaw(
  fill(fragment(`contact-card.${lang}.connect`), { SRC: img.src, SRCSET: img.srcSet.attribute }),
  { QR_DARK: await bookingQr('dark'), QR_LIGHT: await bookingQr('light') },
);
---

<Fragment set:html={html} />
