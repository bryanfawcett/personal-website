---
import type { MineralName } from '../brand/minerals.js';

interface Props {
  title: string;
  description: string;
  href: string;
  /** Which mineral lights the card's edge on hover. */
  mineral?: MineralName;
  /** Call-to-action text. */
  cta?: string;
}

const { title, description, href, mineral = 'tanzanite', cta = 'Visit project' } = Astro.props;
const external = href.startsWith('http');
---

<a
  class="card"
  href={href}
  style={`--card-mineral: var(--mineral-${mineral})`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <h3 class="card__title">{title}</h3>
  <p class="card__description">{description}</p>
  <span class="card__cta">
    {cta}
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--lg);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  /* The mineral reveals as a left edge on hover — colour as a reward, not a default. */
  .card::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 3px;
    background: var(--card-mineral);
    transform: scaleY(0);
    transform-origin: center top;
    transition: transform 0.3s ease;
  }

  .card:hover,
  .card:focus-visible {
    background: var(--container);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card:hover::before,
  .card:focus-visible::before {
    transform: scaleY(1);
  }

  .card__title {
    font-size: 1.0625rem;
    font-weight: 400;
  }

  .card__description {
    flex: 1;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 0.5rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    transition: color 0.3s ease;
  }

  .card:hover .card__cta {
    color: var(--card-mineral);
  }

  .card__cta svg {
    transition: transform 0.3s ease;
  }

  .card:hover .card__cta svg {
    transform: translateX(3px);
  }
</style>
