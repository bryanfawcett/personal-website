---
/**
 * A surface drafted onto the sheet.
 *
 * Carries the span that draws the four corner brackets, and an optional figure
 * tag notched into the top rule. Use this rather than applying `.panel` by hand
 * so every container gets its corners.
 *
 * Any extra attribute (href, target, style, …) passes through to the element.
 */
import type { HTMLAttributes } from 'astro/types';
import { keyedTo, type MineralName } from '../brand/minerals.js';

type Tag = 'section' | 'article' | 'div' | 'li' | 'a';

export type Props<T extends Tag = 'article'> = HTMLAttributes<T> & {
  /**
   * Figure tag notched into the top rule, e.g. "Fig. 01 — Structure".
   *
   * Explicitly `| undefined` because `strictest` turns on
   * `exactOptionalPropertyTypes`, and callers pass indexed lookups.
   */
  fig?: string | undefined;
  /**
   * The mineral this panel is keyed to.
   *
   * Sets `--mineral`, which every mineral mark on the site reads: the bar under
   * a heading, the rule down an edge, the swatch, the list marker. Pass the
   * name; the rule that draws the mark decides its shape, and reads both this
   * property and `--mineral-weight` rather than naming a colour or a thickness
   * of its own. One property, not the eight this replaced.
   *
   * `MineralName` is a union off the mineral list, so a typo fails astro check.
   */
  mineral?: MineralName | undefined;
  /** Element to render as. Defaults to `article`. */
  as?: T | undefined;
};

const { fig, mineral, as: Element = 'article', class: className, style, ...rest } = Astro.props;

const keyed = mineral ? `${keyedTo(mineral)};` : '';
const styles = [keyed, style].filter(Boolean).join(' ');
---

<Element class:list={['panel', className]} style={styles || undefined} {...rest}>
  <span class="panel__rule" aria-hidden="true"></span>
  {fig && <span class="fig">{fig}</span>}
  <slot />
</Element>
