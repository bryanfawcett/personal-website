---
/**
 * The draughtsman, as a plate on the sheet.
 *
 * The markup is Rust (`tools/components/src/portrait.rs`, rendered by `pnpm fragments`).
 * Astro keeps the image pipeline: `astro:assets` resizes the one raster with sharp at build
 * time and content-hashes the URLs, which is why the source lives in src/assets rather than
 * public/. Those hashed values fill the fragment's `%SRC%` and `%SRCSET%`.
 *
 * Fragments exist per variant (see render.rs); a new use needs one.
 */
import { getImage } from 'astro:assets';
import source from '../assets/bryan-fawcett.png';
import { defaultLang, type Lang } from '../i18n/ui.js';
import { fill, fragment } from './fragments.js';

interface Props {
  /** Rendered width in px. Height follows the source's 835×1052. */
  width?: number;
  /** Ruled caption beneath the plate (baked into the fragment). */
  caption?: string | undefined;
  /** Above the fold — skip lazy loading. */
  eager?: boolean;
  class?: string | undefined;
  lang?: Lang;
}

const { width = 200, eager = false, class: className, lang = defaultLang } = Astro.props;
const height = Math.round((width * source.height) / source.width);

if (className !== 'quote__portrait' || !eager || width !== 176) {
  throw new Error('Portrait: no Rust fragment for this variant; add one in tools/components/src/bin/render.rs');
}
const img = await getImage({ src: source, width, height, densities: [1, 2] });
const html = fill(fragment(`portrait.${lang}.quote`), {
  SRC: img.src,
  SRCSET: img.srcSet.attribute,
});
---

<Fragment set:html={html} />
