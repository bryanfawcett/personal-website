---
/**
 * The draughtsman, as a plate on the sheet.
 *
 * The photograph is the one raster on the site, so it gets the same treatment
 * every other container does — a hairline, corner brackets, a ruled caption —
 * rather than sitting on the sheet as a snapshot. Desaturated only part of the
 * way: enough to belong to the drawing, not so far that the face goes muddy.
 *
 * `astro:assets` resizes it with sharp at build time (see `imageService` in
 * astro.config.mjs), which is why the source lives in src/assets rather than
 * public/.
 */
import { Image } from 'astro:assets';
import source from '../assets/bryan-fawcett.png';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  /** Rendered width in px. Height follows the source's 835×1052. */
  width?: number;
  /** Ruled caption beneath the plate. */
  caption?: string | undefined;
  /** Above the fold — skip lazy loading. */
  eager?: boolean;
  class?: string | undefined;
  lang?: Lang;
}

const { width = 200, caption, eager = false, class: className, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const height = Math.round((width * source.height) / source.width);
---

<figure class:list={['portrait', className]}>
  <span class="portrait__plate">
    <span class="panel__rule" aria-hidden="true"></span>
    <Image
      src={source}
      alt={t('nav.portrait_alt')}
      width={width}
      height={height}
      densities={[1, 2]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </span>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

