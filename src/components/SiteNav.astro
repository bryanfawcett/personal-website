---
import { NAV, PROFILE } from '../data/profile.js';

interface Props {
  path: string;
  /** The home page floats the nav over its hero rather than pinning it. */
  floating?: boolean;
}

const { path, floating = false } = Astro.props;

/** `/` matches only itself; every other route also matches its children. */
function isCurrent(href: string): boolean {
  return href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
}
---

<header class:list={['nav', { 'is-floating': floating }]}>
  <nav class="nav__inner shell" aria-label="Main">
    <a class="nav__wordmark" href="/">{PROFILE.name}</a>

    <ul class="nav__list">
      {
        NAV.map((item) => (
          <li>
            <a
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    /* Clears the fixed mineral bar. */
    inset-block-start: 3px;
    z-index: 50;
    background: color-mix(in oklab, var(--base) 82%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--border);
  }

  .nav.is-floating {
    border-block-end-color: transparent;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .nav__wordmark {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    /* Optical centring for the script face. */
    padding-block-start: 0.15em;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav__wordmark:hover {
    color: var(--mineral-tanzanite);
  }

  .nav__list {
    display: flex;
    /* Four items plus a wordmark do not fit a phone; let them wrap. */
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--full);
    font-size: 0.875rem;
    color: var(--muted);
    white-space: nowrap;
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .nav__link:hover {
    color: var(--foreground);
    background: var(--surface);
  }

  .nav__link.is-current {
    color: var(--foreground);
    background: var(--container);
  }

  @media (max-width: 26rem) {
    .nav__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .nav__list {
      justify-content: flex-start;
      margin-inline-start: -0.75rem;
    }
  }
</style>
