---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV, PROFILE, profileInLang } from '../data/profile.js';
import { localizePath, stripLang } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  /** Language-neutral path, e.g. `/experience`. */
  path: string;
  lang: Lang;
  /** Overrides the switcher target where the counterpart is not this path. */
  switchHref?: string | undefined;
}

const { path, lang, switchHref } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);
const here = stripLang(path);

/** `/` matches only itself; every other route also matches its children. */
function isCurrent(href: string): boolean {
  return href === '/' ? here === '/' : here === href || here.startsWith(`${href}/`);
}

/*
 * The commission link is pulled out of the list and given the stamped
 * treatment, so the one action on the site is present on every page rather
 * than reading as the fifth of five equal-weight labels.
 */
const links = NAV.filter((item) => item.href !== '/book');
const book = NAV.find((item) => item.href === '/book');
---

<header class="nav shell">
  <nav class="nav__inner" aria-label={t('nav.label')}>
    <a class="nav__wordmark" href={localizePath('/', lang)}>
      {/*
        A plain <img> at a fixed path, not astro:assets.
        The nav renders on on-demand routes too (/adventures), where
        `imageService: 'compile'` emits a `/_image?…` URL with no service
        behind it — a broken portrait in the masthead on every blog page.
        `pnpm nav-portrait` renders public/nav-portrait.webp from the same
        source; see scripts/build-nav-portrait.mjs.
      */}
      <img
        class="nav__portrait"
        src="/nav-portrait.webp"
        alt=""
        width="46"
        height="46"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="nav__id">
        <span class="nav__name">{PROFILE.name}</span>
        <span class="nav__role">{profile.title}</span>
      </span>
    </a>

    <ul class="nav__list">
      {
        links.map((item) => (
          <li>
            <a
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              href={localizePath(item.href, lang)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }

      <li><LanguageSwitcher lang={lang} path={path} switchHref={switchHref} /></li>

      {
        book && (
          <li>
            <a
              class:list={['nav__link', 'nav__cta', { 'is-current': isCurrent(book.href) }]}
              href={localizePath(book.href, lang)}
              aria-current={isCurrent(book.href) ? 'page' : undefined}
            >
              {t(book.labelKey)}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

