---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV, PROFILE, profileInLang } from '../data/profile.js';
import { localizePath, stripLang } from '../i18n/routing.js';
import { useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  /** Language-neutral path, e.g. `/experience`. */
  path: string;
  lang: Lang;
  /** Overrides the switcher target where the counterpart is not this path. */
  switchHref?: string | undefined;
}

const { path, lang, switchHref } = Astro.props;
const t = useTranslations(lang);
const profile = profileInLang(lang);
const here = stripLang(path);

/** `/` matches only itself; every other route also matches its children. */
function isCurrent(href: string): boolean {
  return href === '/' ? here === '/' : here === href || here.startsWith(`${href}/`);
}

/*
 * The commission link is pulled out of the list and given the stamped
 * treatment, so the one action on the site is present on every page rather
 * than reading as the fifth of five equal-weight labels.
 */
const links = NAV.filter((item) => item.href !== '/book');
const book = NAV.find((item) => item.href === '/book');
---

<header class="nav shell">
  <nav class="nav__inner" aria-label={t('nav.label')}>
    <a class="nav__wordmark" href={localizePath('/', lang)}>
      {/*
        A plain <img> at a fixed path, not astro:assets.
        The nav renders on on-demand routes too (/adventures), where
        `imageService: 'compile'` emits a `/_image?…` URL with no service
        behind it — a broken portrait in the masthead on every blog page.
        `pnpm nav-portrait` renders public/nav-portrait.webp from the same
        source; see scripts/build-nav-portrait.mjs.
      */}
      <img
        class="nav__portrait"
        src="/nav-portrait.webp"
        alt=""
        width="46"
        height="46"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="nav__id">
        <span class="nav__name">{PROFILE.name}</span>
        <span class="nav__role">{profile.title}</span>
      </span>
    </a>

    <ul class="nav__list">
      {
        links.map((item) => (
          <li>
            <a
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              href={localizePath(item.href, lang)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }

      <li><LanguageSwitcher lang={lang} path={path} switchHref={switchHref} /></li>

      {
        book && (
          <li>
            <a
              class:list={['nav__link', 'nav__cta', { 'is-current': isCurrent(book.href) }]}
              href={localizePath(book.href, lang)}
              aria-current={isCurrent(book.href) ? 'page' : undefined}
            >
              {t(book.labelKey)}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    padding-block-start: 2.25rem;
  }

  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--ink-faint);
  }

  .nav__wordmark {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  /*
   * The file is already square and already cropped onto the face — see
   * scripts/build-nav-portrait.mjs — so no object-position reframing here.
   */
  .nav__portrait {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border: 1px solid var(--ink-faint);
    filter: grayscale(0.5) contrast(1.05);
  }

  .nav__id {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav__name {
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--ink);
  }

  .nav__role {
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: var(--label-weight);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav__link.is-current {
    color: var(--ink);
    background: var(--sheet-wash-light);
    border-color: var(--ink);
  }

  /*
   * The commission stamp.
   *
   * A full-strength rule and ink rather than a fill: this is the site's one
   * standing call to action, and it has to read as the loudest thing in the
   * nav without becoming a button floating over the sheet. On hover the ink
   * and the ground swap, which is the same move the social links already
   * make — no lift, no shadow.
   */
  .nav__cta {
    color: var(--ink);
    border-color: var(--ink);
  }

  .nav__cta:hover,
  .nav__cta.is-current {
    color: var(--sheet-raised);
    background: var(--ink);
    border-color: var(--ink);
  }

  /* Mono tracking meant for Latin caps opens Han glyphs up too far. */
  .nav__link:lang(zh),
  .nav__role:lang(zh) {
    font-family: var(--cjk-mono);
    letter-spacing: 0.1em;
    text-transform: none;
  }

  @media (max-width: 40rem) {
    .nav__inner {
      align-items: flex-start;
    }

    .nav__list {
      margin-inline-start: -0.875rem;
    }
  }
</style>
