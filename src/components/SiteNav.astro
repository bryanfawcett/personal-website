---
import { NAV, PROFILE } from '../data/profile.js';

interface Props {
  path: string;
}

const { path } = Astro.props;

/** `/` matches only itself; every other route also matches its children. */
function isCurrent(href: string): boolean {
  return href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
}
---

<header class="nav shell">
  <nav class="nav__inner" aria-label="Main">
    <a class="nav__wordmark" href="/">
      <span class="nav__name">{PROFILE.name}</span>
      <span class="nav__role">{PROFILE.title}</span>
    </a>

    <ul class="nav__list">
      {
        NAV.map((item) => (
          <li>
            <a
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    padding-block-start: 2.25rem;
  }

  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 0.75rem;
    border-block-end: 1.5px solid var(--ink-soft);
  }

  .nav__wordmark {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav__name {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .nav__role {
    font-family: var(--mono);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav__link.is-current {
    color: var(--ink);
    background: var(--parch-wash-light);
    border-color: var(--ink);
  }

  @media (max-width: 40rem) {
    .nav__inner {
      align-items: flex-start;
    }

    .nav__list {
      margin-inline-start: -0.875rem;
    }
  }
</style>
