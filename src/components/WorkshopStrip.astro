---
/**
 * Three drafted views of the workshop, pinned to the sheet at slight angles —
 * a photo strip, but drawn rather than photographed.
 *
 * The drawings are decorative; the captions carry the meaning, so the figures
 * are hidden from assistive technology and the captions are not.
 */
import Panel from './Panel.astro';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="strip" aria-label={t('home.strip_label')}>
  <Panel class="strip__plate">
    <svg viewBox="0 0 260 120" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <rect x="30" y="30" width="90" height="70"></rect>
      <path d="M30 30l45-18 45 18"></path>
      <rect x="55" y="60" width="18" height="40"></rect>
      <rect x="92" y="55" width="16" height="16" stroke-dasharray="2 3"></rect>
      <path d="M140 100h90" stroke-dasharray="4 4"></path>
      <path d="M160 100v-46h50v46"></path>
      <circle cx="185" cy="76" r="9" stroke-dasharray="2 3"></circle>
    </svg>
    <p class="caption"><span>{t('home.strip_a')}</span><span>Fig. A</span></p>
  </Panel>

  <Panel class="strip__plate">
    <svg viewBox="0 0 260 120" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M40 100h180"></path>
      <path d="M70 100V44h20v56M110 100V30h22v70M152 100V52h18v48M190 100V38h20v62"></path>
      <path d="M60 24h150" stroke-dasharray="2 4"></path>
      <circle cx="50" cy="24" r="6"></circle>
    </svg>
    <p class="caption"><span>{t('home.strip_b')}</span><span>Fig. B</span></p>
  </Panel>

  <Panel class="strip__plate">
    <svg viewBox="0 0 260 120" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <rect x="35" y="40" width="190" height="14"></rect>
      <path d="M50 54v46M210 54v46"></path>
      <path d="M80 40V26h30v14M150 40l14-16 14 16"></path>
      <path d="M100 70h60" stroke-dasharray="3 3"></path>
      <path d="M100 66v8M160 66v8"></path>
    </svg>
    <p class="caption"><span>{t('home.strip_c')}</span><span>Fig. C</span></p>
  </Panel>
</section>

