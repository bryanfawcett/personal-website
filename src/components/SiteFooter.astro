---
import { NAV, PROFILE, socialsInLang } from '../data/profile.js';
import MineralBar from './MineralBar.astro';
import { localizePath } from '../i18n/routing.js';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <MineralBar thickness="2px" />

  <div class="footer__inner shell">
    <div class="footer__identity">
      <p class="footer__wordmark">{PROFILE.name}</p>
      <p class="eyebrow">Digital craftsman, builder of communities</p>
      <p class="footer__copy">© {year} {PROFILE.name}. All rights reserved.</p>
    </div>

    <div class="footer__columns">
      <nav class="footer__nav" aria-label={t('nav.footer')}>
        <p class="eyebrow">Site</p>
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={localizePath(item.href, lang)}>{t(item.labelKey)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__nav">
        <p class="eyebrow">Elsewhere</p>
        <ul>
          {
            socialsInLang(lang).map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {social.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

