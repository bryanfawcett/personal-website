---
/**
 * The footer is Rust: `tools/components/src/footer.rs`, rendered per language and route to
 * a fragment (see `components/fragments.ts`). The sheet number and the year are the two
 * things filled in here; the year is computed at build time, as it always was.
 */
import type { Lang } from '../../i18n/ui.js';
import { fill, fragment, routeKey } from '../fragments.js';

interface Props {
  lang: Lang;
  /** The drawing's sheet number, carried in the bottom bar as a title block would. */
  sheet?: string;
  /** The current route, so the footer's own navigation marks where the reader is. */
  path?: string;
}

const { lang, sheet = '01 / 06', path = '' } = Astro.props;
const html = fill(fragment(`footer.${lang}.${routeKey(path)}`), {
  SHEET: sheet,
  YEAR: String(new Date().getFullYear()),
});
---

<Fragment set:html={html} />
