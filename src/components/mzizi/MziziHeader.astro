---
/**
 * The header is Rust: `tools/components/src/header.rs`, rendered per language and route
 * to a fragment (see `components/fragments.ts`). This file inserts it and carries the one
 * script the header needs, the theme toggle's.
 */
import { alternatePath } from '../../i18n/routing.js';
import type { Lang } from '../../i18n/ui.js';
import { fill, fragment, routeKey } from '../fragments.js';

interface Props {
  /** Language-neutral path, e.g. `/experience`. */
  path: string;
  lang: Lang;
  /** Overrides the switcher target where the counterpart is not this path. */
  switchHref?: string | undefined;
}

const { path, lang, switchHref } = Astro.props;
const html = fill(fragment(`header.${lang}.${routeKey(path)}`), {
  SWITCH: switchHref ?? alternatePath(path, lang),
});
---

<Fragment set:html={html} />

<script>
  /*
   * The theme toggle. Delegated from `document`, so it survives the router's
   * document swaps without re-binding — the same reason the analytics
   * listener is delegated.
   */
  const effective = (): 'light' | 'dark' => {
    const chosen = document.documentElement.dataset['theme'];
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const label = () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const text = button.dataset[next === 'light' ? 'labelLight' : 'labelDark'];
      if (text) button.setAttribute('aria-label', text);
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-theme-toggle]')) return;
    const next = effective() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset['theme'] = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Private mode: the choice holds for this page only. */
    }
    label();
  });

  /*
   * A reader on /minerals should not land with their own page scrolled out of
   * the row. Scroll the row itself — never the page — to bring it in.
   */
  const reveal = () => {
    const row = document.querySelector<HTMLElement>('.mzizi-header__row');
    const current = row?.querySelector<HTMLElement>('.is-current');
    if (!row || !current) return;
    const overflow = current.offsetLeft + current.offsetWidth - row.clientWidth;
    if (overflow > 0) row.scrollLeft = overflow + 16;
  };

  document.addEventListener('astro:page-load', () => {
    label();
    reveal();
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
</script>
