---
/**
 * The other language, one click away.
 *
 * It points at the *same page* in the other language rather than at that
 * language's home page — every route exists in both, so there is no reason to
 * throw a reader back to the top of the site for switching.
 *
 * Styled as a nav link rather than as a control: on a sheet of drawings a
 * dropdown would be the only widget on the page.
 */
import { languages, useTranslations, bcp47, type Lang } from '../i18n/ui.js';
import { alternatePath } from '../i18n/routing.js';

interface Props {
  lang: Lang;
  /** Language-neutral or localized path of the current page. */
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'en' ? 'zh' : 'en';
---

<a
  class="lang"
  href={alternatePath(path, lang)}
  hreflang={bcp47[other]}
  lang={bcp47[other]}
  aria-label={t('nav.switch_lang_label')}
>
  {languages[other]}
</a>

<style>
  .lang {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid var(--ink-hair);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  /*
   * The Chinese label is set in the CJK stack, where the mono tracking meant
   * for Latin caps opens the glyphs up too far.
   */
  .lang:lang(zh) {
    font-family: var(--cjk);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .lang:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
</style>
