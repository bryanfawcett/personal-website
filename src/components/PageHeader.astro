---
import { fill, fragment, splitSlot } from './fragments.js';

interface Props {
  eyebrow: string;
  title: string;
  /**
   * Explicitly `| undefined` on the optional props, as `Panel` does: under
   * `strictest` these carry `exactOptionalPropertyTypes`, so a caller passing
   * a value that may be undefined — an adventure with no excerpt, say — is a
   * type error without it.
   */
  lede?: string | undefined;
  /** Pencil note in the margin. */
  note?: string | undefined;
}

const { eyebrow, title, lede, note } = Astro.props;

/* Rust renders the header (`tools/components/src/page_header.rs`): one fragment per
   combination of lede and note, with the page's own children slotted at `%SLOT%`. */
const [head, tail] = splitSlot(
  fill(fragment(`page-header.${lede ? 'l' : ''}${note ? 'n' : ''}`), {
    EYEBROW: eyebrow,
    TITLE: title,
    LEDE: lede ?? '',
    NOTE: note ?? '',
  }),
);
---

<Fragment set:html={head} /><slot /><Fragment set:html={tail} />
