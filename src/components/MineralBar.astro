---
/**
 * The mineral rail — the site's brand signature.
 *
 * Seven segments, one per Mzizi mineral, in system order, running vertically
 * down the binding edge of the sheet. It is the one place saturated colour
 * appears on an otherwise ink-on-parchment drawing, which is what makes it
 * read as an identity mark rather than decoration.
 *
 * Purely decorative: hidden from assistive technology, with each mineral's
 * meaning available as a tooltip for sighted users who hover.
 */
import { MINERALS } from '../brand/minerals.js';

interface Props {
  /** `edge` pins it to the viewport's binding edge; `inline` sits it in flow. */
  placement?: 'edge' | 'inline';
  /** Rail thickness. */
  thickness?: string;
  class?: string;
}

const { placement = 'edge', thickness = '6px', class: className = '' } = Astro.props;
---

<div
  class:list={['mineral-rail', `is-${placement}`, className]}
  style={`--rail-thickness: ${thickness}`}
  aria-hidden="true"
>
  {
    MINERALS.map((m) => (
      <span
        class="mineral-rail__segment"
        style={`background: var(--mineral-${m.name}-vivid)`}
        title={`${m.name} — ${m.symbolism}. From ${m.origin}.`}
      />
    ))
  }
</div>

<style>
  .mineral-rail {
    display: flex;
    flex-direction: column;
    width: var(--rail-thickness);
  }

  .mineral-rail.is-edge {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 60;
    height: 100dvh;
  }

  .mineral-rail.is-inline {
    height: 100%;
  }

  .mineral-rail__segment {
    flex: 1;
    /* Segments draw down the edge on load rather than snapping in. */
    transform: scaleY(0);
    transform-origin: center top;
    animation: mineral-rail-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .mineral-rail__segment:nth-child(1) {
    animation-delay: 0.02s;
  }
  .mineral-rail__segment:nth-child(2) {
    animation-delay: 0.06s;
  }
  .mineral-rail__segment:nth-child(3) {
    animation-delay: 0.1s;
  }
  .mineral-rail__segment:nth-child(4) {
    animation-delay: 0.14s;
  }
  .mineral-rail__segment:nth-child(5) {
    animation-delay: 0.18s;
  }
  .mineral-rail__segment:nth-child(6) {
    animation-delay: 0.22s;
  }
  .mineral-rail__segment:nth-child(7) {
    animation-delay: 0.26s;
  }

  @keyframes mineral-rail-in {
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mineral-rail__segment {
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 51rem) {
    .mineral-rail.is-edge {
      width: 4px;
    }
  }
</style>
