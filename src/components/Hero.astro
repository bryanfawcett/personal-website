---
/**
 * The sheet's headline: the title stacked, with the second word drafted in
 * outline as though it has been ruled but not yet inked in.
 */
import { defaultLang, type Lang } from '../i18n/ui.js';
import { fill, fragment, splitSlot } from './fragments.js';

interface Props {
  /** Two words: the first solid, the second in outline. */
  solid: string;
  drafted: string;
  eyebrow: string;
  sub?: string;
  /** Pencil note pinned in the right margin. */
  note?: string;
  /** Label on the dimension line beneath. */
  dimension?: string;
  /** Show the name and role strip under the title. */
  showByline?: boolean;
  lang?: Lang;
}

const {
  solid,
  drafted,
  eyebrow,
  sub,
  note,
  dimension = 'Drawn to scale',
  showByline = false,
  lang = defaultLang,
} = Astro.props;

const hasSlot = Astro.slots.has('default');

/* Rust renders the hero (`tools/components/src/hero.rs`), one fragment per language and
   combination of byline, sub, note and actions. The note is trusted markup, so it is set
   after `fill` (which escapes); a newline becomes `<br>` as before. */
const key = `${showByline ? 'b' : ''}${sub ? 's' : ''}${note ? 'n' : ''}${hasSlot ? 'a' : ''}`;
const filled = fill(fragment(`hero.${lang}.${key}`), {
  SOLID: solid,
  DRAFTED: drafted,
  EYEBROW: eyebrow,
  SUB: sub ?? '',
  DIMENSION: dimension,
});
const [head, tail] = splitSlot(
  note ? filled.replace('%NOTE%', () => note.replace(/\n/g, '<br>')) : filled,
);
---

<Fragment set:html={head} />{hasSlot && <slot />}<Fragment set:html={tail} />
