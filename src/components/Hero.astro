---
import { PROFILE } from '../data/profile.js';

const year = new Date().getFullYear();
---

<section class="hero" aria-labelledby="hero-name">
  <img
    class="hero__portrait"
    src="/profile.png"
    alt=""
    width="835"
    height="1052"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__scrim"></div>

  <div class="hero__content shell">
    <h1 class="hero__name" id="hero-name">{PROFILE.name}</h1>

    <p class="hero__badge">{PROFILE.title} / {year}</p>

    <p class="hero__tagline">{PROFILE.tagline}</p>

    <ul class="hero__socials">
      {
        PROFILE.socials.map((social) => (
          <li>
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: end center;
    min-height: min(88dvh, 52rem);
    background: var(--pitch);
    isolation: isolate;
  }

  .hero__portrait,
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Portrait source in a landscape frame: cover crops hard, so bias the
       visible band down to keep the whole face rather than the forehead. */
    object-position: center 34%;
  }

  /* Keeps the wordmark legible over any part of the photograph. */
  .hero__scrim {
    background:
      linear-gradient(to bottom, rgb(5 5 5 / 0.35) 0%, rgb(5 5 5 / 0.1) 35%, rgb(5 5 5 / 0.85) 88%, var(--base) 100%);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block-end: 3.5rem;
    text-align: center;
  }

  .hero__name {
    font-family: var(--serif);
    font-size: clamp(2.75rem, 1.5rem + 5.5vw, 5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__badge {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--full);
    background: color-mix(in oklab, var(--pitch) 55%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--foreground);
  }

  .hero__tagline {
    max-width: 26rem;
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 300;
    color: color-mix(in oklab, var(--foreground) 88%, transparent);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin-block-start: 0.5rem;
  }

  .hero__socials a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 70%, transparent);
    transition: color 0.25s ease;
  }

  .hero__socials a:hover {
    color: var(--mineral-gold);
  }
</style>
