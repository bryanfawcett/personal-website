---
/**
 * The missing sheet.
 *
 * Cloudflare serves one `404.html` for the whole zone, so this page cannot
 * know which language the reader wanted — it carries both, English first, with
 * the Chinese route offered underneath rather than behind a switcher that
 * would only ever point back at itself.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { NAV } from '../data/profile.js';
import { localizePath } from '../i18n/routing.js';
import { useTranslations } from '../i18n/ui.js';

const t = useTranslations('en');
const zh = useTranslations('zh');
---

<BaseLayout
  title={t('nf.title')}
  description={t('nf.description')}
  path="/404"
  lang="en"
  sheet="— / 06"
>
  <PageHeader
    eyebrow={t('nf.eyebrow')}
    title={t('nf.heading')}
    lede={t('nf.lede')}
    note={t('nf.note')}
  />

  <ul class="options">
    {
      NAV.map((item) => (
        <li>
          <a class="btn is-ghost" href={item.href}>
            {t(item.labelKey)}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="options__zh" lang="zh-Hans">
    {zh('nf.lede')}
    <a href={localizePath('/', 'zh')}>{zh('nav.profile')} →</a>
  </p>
</BaseLayout>

