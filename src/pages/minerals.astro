---
/**
 * The rail, explained.
 *
 * The seven segments running down the binding edge are the site's only
 * saturated colour, and nowhere said what they were. Every figure on this
 * page — the contrast ratios especially — is computed at build time from the
 * same tokens the rail draws with, so the page cannot drift from the rail.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Panel from '../components/Panel.astro';
import { MINERALS } from '../brand/minerals.js';
import { SHEET } from '../brand/tokens.js';
import { rating, ratio } from '../brand/contrast.js';

const MZIZI = 'https://mzizi.dev';

/** Measured against the sheet the rail is actually drawn on. */
const rows = MINERALS.map((m) => ({
  ...m,
  onSheet: ratio(m.hex, SHEET.base),
  grade: rating(Number.parseFloat(ratio(m.hex, SHEET.base))),
}));
---

<BaseLayout
  title="The mineral rail"
  description="Seven minerals from across Africa, one per segment of the rail down the edge of every page — what each stands for, where it is mined, and how it is used. Drawn from the Mzizi design system."
  path="/minerals"
  sheet="04 / 05"
>
  <PageHeader
    eyebrow="Sheet 04 · Legend"
    title="The mineral rail"
    lede="Seven segments run down the binding edge of every page on this site. Each is a mineral mined in Africa, and each carries a meaning the interface actually uses. This is the key."
    note="read the edge"
  />

  <section class="section reveal" aria-labelledby="why-heading">
    <Panel fig="Fig. 01 — Why stones">
      <h2 id="why-heading">Why stones, and not a palette</h2>
      <p>
        A palette named <em>primary</em>, <em>secondary</em> and <em>accent</em> tells you where a
        colour goes and nothing about why it exists. The
        <a href={MZIZI} target="_blank" rel="noopener noreferrer">Mzizi design system</a> names its
        colours after minerals mined across the continent, and keeps the provenance attached: where
        the stone comes from, what it stands for, what it is for in an interface.
      </p>
      <p>
        That provenance is the point. Cobalt out of Katanga is in the phone you are reading this on.
        Naming the link colour after it is a small refusal to treat the material as abstract.
      </p>
      <p>
        Mzizi is a <em>nyuchi</em> project in the Bundu ecosystem, built on the Ubuntu principle
        that gives the whole thing its shape — <em>I am because we are</em>. The system, its tokens
        and its accessibility toolkit are at <a
          href={MZIZI}
          target="_blank"
          rel="noopener noreferrer">mzizi.dev</a
        >.
      </p>
    </Panel>
  </section>

  <section class="section reveal" aria-labelledby="key-heading">
    <div class="section-head">
      <p class="eyebrow is-open">Sheet 04 · The seven</p>
      <span class="margin-note">top to bottom</span>
    </div>
    <h2 class="visually-hidden" id="key-heading">The seven minerals</h2>

    <ol class="key">
      {
        rows.map((m, i) => (
          <li>
            <Panel as="article" class="key__item" style={`--m: var(--mineral-${m.name})`}>
              <span class="key__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="key__swatch" aria-hidden="true" />

              <div class="key__body">
                <h3>{m.name}</h3>
                <dl>
                  <dt>Means</dt>
                  <dd>{m.symbolism}</dd>
                  <dt>Mined in</dt>
                  <dd>{m.origin}</dd>
                  <dt>Used for</dt>
                  <dd>{m.usage}</dd>
                </dl>
              </div>

              <div class="key__figures">
                <span class="key__hex">{m.hex}</span>
                <span class="key__ratio">
                  {m.onSheet} <span class="key__grade">{m.grade}</span>
                </span>
              </div>
            </Panel>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section reveal" aria-labelledby="a11y-heading">
    <Panel fig="Fig. 02 — Accessibility">
      <h2 id="a11y-heading">Every one of them, measured</h2>
      <p>
        The ratios above are WCAG 2.2 contrast against this site&rsquo;s ground (<code
          >{SHEET.base}</code
        >), computed at build time from the same tokens the rail draws with. They are not claims
        copied off a swatch sheet — if a token changes, the number on this page changes with it.
      </p>
      <p>
        Mzizi ships the checking as part of the system rather than leaving it to each consumer:
        contrast against its APCA and AAA floors, plus colour-vision simulation, available in the
        toolkit at <a href={MZIZI} target="_blank" rel="noopener noreferrer">mzizi.dev</a> and over
        its MCP server, so an agent building against the system can verify a pairing before it
        ships it.
      </p>
      <p>
        On this site the minerals are a <em>non-text</em> mark, so the bar they have to clear is
        WCAG 2.2 SC 1.4.11 at 3:1 — which every one of the seven does. Colour is never the only
        carrier of meaning here: the rail is <code>aria-hidden</code>, every segment names itself on
        hover, and this page is the text alternative.
      </p>
    </Panel>
  </section>
</BaseLayout>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .key {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    counter-reset: mineral;
  }

  .key :global(.key__item) {
    display: grid;
    grid-template-columns: auto 4px 1fr auto;
    align-items: start;
    gap: 0 1.25rem;
    padding: 1.5rem 1.625rem;
  }

  .key__index {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    padding-block-start: 0.35rem;
  }

  /* The segment itself, lifted off the rail and stood on end. */
  .key__swatch {
    align-self: stretch;
    min-height: 3.5rem;
    background: var(--m);
  }

  .key__body h3 {
    font-size: 1.375rem;
    text-transform: capitalize;
    color: var(--m);
  }

  .key__body dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin-block-start: 0.625rem;
  }

  .key__body dt {
    font-family: var(--mono);
    /* 10px floor on label text. */
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-block-start: 0.3rem;
  }

  .key__body dd {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--ink-body);
  }

  .key__figures {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-align: end;
  }

  .key__hex {
    color: var(--m);
    text-transform: uppercase;
  }

  .key__ratio {
    color: var(--ink-soft);
  }

  .key__grade {
    display: block;
    margin-block-start: 2px;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .panel a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 44rem) {
    .key :global(.key__item) {
      grid-template-columns: auto 4px 1fr;
      row-gap: 1rem;
      padding: 1.25rem;
    }

    .key__figures {
      grid-column: 3;
      align-items: flex-start;
      text-align: start;
    }

    .key__grade {
      display: inline;
      margin-inline-start: 0.5rem;
    }
  }
</style>
