---
import '../styles/fonts.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { tokensToCss } from '../brand/tokens.js';
import { unroll } from '../brand/transitions.js';
import MineralBar from '../components/MineralBar.astro';
import Schematics from '../components/Schematics.astro';
import SiteNav from '../components/SiteNav.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { PROFILE, profileInLang } from '../data/profile.js';
import { allPaths, alternatePath, localizePath } from '../i18n/routing.js';
import { bcp47, defaultLang, direction, ogLocale, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  title: string;
  description: string;
  /**
   * Language-neutral path, e.g. "/experience". The locale prefix is added
   * from `lang`, so a page never has to spell its own Chinese URL.
   */
  path?: string;
  lang?: Lang;
  /**
   * The same page's URL in each language, when it cannot be derived from
   * `path`.
   *
   * Every hand-authored route is the same path with a locale prefix, so the
   * default is computed. An adventure is not: its Chinese translation is a
   * separate document with its own slug, and an untranslated one has no
   * Chinese URL at all. Those pages pass this instead.
   */
  alternates?: Partial<Record<Lang, string>>;
  /** Sheet number shown in the title block, e.g. "02 / 06". */
  sheet?: string;
  ogType?: 'website' | 'profile' | 'article';
}

const {
  title,
  description,
  path = Astro.url.pathname,
  lang = defaultLang,
  alternates,
  sheet = '01 / 06',
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://bryanfawcett.com');

/*
 * Which languages this page genuinely exists in.
 *
 * For a hand-authored route that is both of them, derived from the path. For
 * an adventure it is whatever `alternates` says — and an untranslated one
 * lists only English, because pointing `hreflang="zh-Hans"` at a page that is
 * not a Chinese version of this one is a lie told to a search engine.
 */
const localized = alternates
  ? (Object.entries(alternates) as [Lang, string][]).map(([entryLang, entryPath]) => ({
      lang: entryLang,
      path: entryPath,
    }))
  : allPaths(path);

const here = localized.find((entry) => entry.lang === lang)?.path ?? localizePath(path, lang);
const canonical = new URL(here, site).href;
const fullTitle = here === '/' || here === '/zh' ? title : `${title} | ${PROFILE.name}`;

/*
 * Where the language switcher goes.
 *
 * The real counterpart when there is one; otherwise the other language's
 * version of this *section*. On an untranslated adventure that lands the
 * reader on the Chinese list rather than on a dead end or, worse, silently
 * back at the home page.
 */
const switchHref = alternates?.[lang === 'en' ? 'zh' : 'en'] ?? alternatePath(path, lang);

/*
 * Google Analytics 4.
 *
 * `send_page_view: false`, and the page_view sent from `astro:page-load`
 * instead. The ClientRouter swaps the document without a reload, so gtag's
 * own automatic page view only ever fires for the first sheet a reader
 * lands on and every later navigation goes uncounted. Sending it from the
 * router's own event counts all of them — and leaving the automatic one on
 * as well would double-count the first, since `astro:page-load` fires on
 * the initial load too.
 *
 * The loader and this bootstrap are byte-identical on every page, so the
 * router recognises them as already-present and does not re-run them: gtag
 * is initialised once and the listener below is bound once.
 */
const GA_MEASUREMENT_ID = 'G-SHMBW3J3V7';
const gaBootstrap = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}', { send_page_view: false });

  document.addEventListener('astro:page-load', function () {
    gtag('event', 'page_view', {
      page_location: location.href,
      page_title: document.title,
    });
  });
`;

const profile = profileInLang(lang);
const t = useTranslations(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://bryanfawcett.com/#person',
      name: PROFILE.name,
      givenName: 'Bryan',
      familyName: 'Fawcett',
      jobTitle: profile.roles.map((r) => r.title),
      description: profile.summary,
      url: 'https://bryanfawcett.com',
      email: `mailto:${PROFILE.email}`,
      image: 'https://bryanfawcett.com/og-bryan-fawcett.jpg',
      sameAs: PROFILE.socials.map((s) => s.href),
      worksFor: profile.roles.map((r) => ({ '@type': 'Organization', name: r.org })),
      founder: [
        { '@type': 'Organization', name: 'Nyuchi Africa', url: 'https://nyuchi.com' },
        { '@type': 'Organization', name: 'The Bundu Foundation', url: 'https://www.bundu.org' },
      ],
      knowsAbout: PROFILE.knowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': 'https://bryanfawcett.com/#website',
      url: 'https://bryanfawcett.com',
      name: `${PROFILE.name} — ${profile.title}`,
      publisher: { '@id': 'https://bryanfawcett.com/#person' },
      inLanguage: bcp47[lang],
    },
  ],
};
---

<!doctype html>
<html lang={bcp47[lang]} dir={direction[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A1826" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Both languages of this page, plus x-default pointing at English.
      Every route exists in both, so these are always real URLs.
    */}
    {
      localized.map((entry) => (
        <link rel="alternate" hreflang={bcp47[entry.lang]} href={new URL(entry.path, site).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localized.find((e) => e.lang === defaultLang)?.path ?? here, site).href}
    />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      localized
        .filter((entry) => entry.lang !== lang)
        .map((entry) => <meta property="og:locale:alternate" content={ogLocale[entry.lang]} />)
    }
    <meta property="og:image" content="https://bryanfawcett.com/og-bryan-fawcett.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bryan Fawcett — Digital Craftsman" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@bryanfawcett" />

    {/* Fonts are self-hosted (see scripts/fetch-fonts.py) — no third-party request. */}
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Design tokens, generated from src/brand/tokens.ts at build time. */}
    <style is:global set:html={tokensToCss()}></style>

    <script is:inline>
      // Flip off the no-JS fallback before first paint so revealed sections
      // start hidden rather than flashing in and then animating.
      document.documentElement.classList.remove('no-js');
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/* Google Analytics. Loaded on every sheet, unlike the Cal.com embed on /book. */}
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline set:html={gaBootstrap}></script>

    <ClientRouter />
  </head>

  <body>
    {/* The sheet, bottom to top: ground, ruling, drawings, rail. */}
    <div class="sheet-ground" aria-hidden="true"></div>
    <div class="blueprint" aria-hidden="true"></div>
    <Schematics />
    <MineralBar placement="edge" transition:persist />

    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    <div class="page">
      <SiteNav path={path} lang={lang} switchHref={switchHref} />

      <main id="main" class="shell" transition:animate={unroll}>
        <slot />
      </main>

      <div class="shell">
        <TitleBlock sheet={sheet} lang={lang} path={path} switchHref={switchHref} />
      </div>
    </div>

    <script>
      // Reveal sections as they enter the viewport.
      //
      // threshold 0: a section taller than the viewport can never reach a
      // meaningful intersection ratio, so anything long would otherwise stay
      // at opacity 0 forever on a phone.
      //
      // Bound to astro:page-load rather than run once: the ClientRouter swaps
      // the document without a reload, so a one-shot observer would only ever
      // see the first page's sections and every later page would stay at
      // opacity 0. The old observer is disconnected first so they do not stack.
      let observer: IntersectionObserver | undefined;

      document.addEventListener('astro:page-load', () => {
        observer?.disconnect();

        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer?.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0 },
        );

        for (const target of document.querySelectorAll<HTMLElement>('.reveal')) {
          observer.observe(target);
        }
      });
    </script>
  </body>
</html>
