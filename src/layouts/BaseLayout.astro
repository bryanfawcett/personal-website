---
/*
 * The Bundu standard first: @bundu/ui's tokens carry all 21 Mzizi colour
 * families, the surface ladder and the radius scale. The site's own tokens
 * and global.css build on top of them, so they load after.
 */
import '@bundu/ui/styles/tokens.css';
import '@bundu/ui/styles/color-scheme.css';
import '../styles/fonts.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SHEET, SHEET_LIGHT } from '../brand/tokens.js';
import tokensCss from '../styles/tokens.css?raw';
import { unroll } from '../brand/transitions.js';
import MineralStrip from '@bundu/ui/MineralStrip.astro';
import Schematics from '../components/Schematics.astro';
import MziziHeader from '../components/mzizi/MziziHeader.astro';
import MziziFooter from '../components/mzizi/MziziFooter.astro';
import SeoHead from 'rust:seo-head';
import { SITE_URL } from '../data/site.js';
import { seoHeadProps, type SeoHeadInput } from './seo-head.js';
import { alternatePath } from '../i18n/routing.js';
import { bcp47, defaultLang, direction, useTranslations, type Lang } from '../i18n/ui.js';

interface Props {
  title: string;
  description: string;
  /**
   * Language-neutral path, e.g. "/experience". The locale prefix is added
   * from `lang`, so a page never has to spell its own Chinese URL.
   */
  path?: string;
  lang?: Lang;
  /**
   * The same page's URL in each language, when it cannot be derived from
   * `path`.
   *
   * Every hand-authored route is the same path with a locale prefix, so the
   * default is computed. An adventure is not: its Chinese translation is a
   * separate document with its own slug, and an untranslated one has no
   * Chinese URL at all. Those pages pass this instead.
   */
  alternates?: Partial<Record<Lang, string>>;
  /** Sheet number shown in the title block, e.g. "02 / 06". */
  sheet?: string;
  ogType?: 'website' | 'profile' | 'article';
  /** A page's own share image, and a post's article metadata (see seo-head.ts). */
  image?: SeoHeadInput['image'];
  article?: SeoHeadInput['article'];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  lang = defaultLang,
  alternates,
  sheet = '01 / 06',
  ogType = 'website',
  image,
  article,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);

/*
 * The SEO head (title, description, canonical, hreflang, Open Graph, Twitter, JSON-LD) is
 * rendered in Rust by `mzizi-discovery`, through `rust:seo-head`. `seoHeadProps` works out
 * which URLs and languages from the routing tables; see src/layouts/seo-head.ts.
 */
const seoProps = seoHeadProps({ title, description, path, lang, alternates, ogType, site, image, article });

/*
 * Where the language switcher goes.
 *
 * The real counterpart when there is one; otherwise the other language's
 * version of this *section*. On an untranslated adventure that lands the
 * reader on the Chinese list rather than on a dead end or, worse, silently
 * back at the home page.
 */
const switchHref = alternates?.[lang === 'en' ? 'zh' : 'en'] ?? alternatePath(path, lang);

/*
 * Google Analytics 4.
 *
 * `send_page_view: false`, and the page_view sent from `astro:page-load`
 * instead. The ClientRouter swaps the document without a reload, so gtag's
 * own automatic page view only ever fires for the first sheet a reader
 * lands on and every later navigation goes uncounted. Sending it from the
 * router's own event counts all of them — and leaving the automatic one on
 * as well would double-count the first, since `astro:page-load` fires on
 * the initial load too.
 *
 * The loader and this bootstrap are byte-identical on every page, so the
 * router recognises them as already-present and does not re-run them: gtag
 * is initialised once and the listeners below are bound once.
 *
 * The second listener counts outbound clicks on the ecosystem grid, which is
 * the one thing on this site that answers a question worth asking: which of
 * the projects a reader actually follows. It is delegated from `document`
 * rather than bound per link, so it survives the router's document swaps
 * without re-binding and without stacking, and it reads `data-track-project`
 * — the *English* title, set in `work.ts` — rather than the link's own text,
 * which carries a Chinese gloss on two of the projects.
 *
 * The event is deliberately not named `click`. GA4's Enhanced Measurement
 * emits its own `click` for every outbound link and is on by default, so
 * reusing that name would count each of these twice.
 */
const GA_MEASUREMENT_ID = 'G-SHMBW3J3V7';
const gaBootstrap = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}', { send_page_view: false });

  document.addEventListener('astro:page-load', function () {
    gtag('event', 'page_view', {
      page_location: location.href,
      page_title: document.title,
    });
  });

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target || typeof target.closest !== 'function') return;
    var link = target.closest('[data-track-project]');
    if (!link) return;

    gtag('event', 'ecosystem_click', {
      project: link.dataset.trackProject,
      project_group: link.dataset.trackGroup,
      link_url: link.href,
      site_language: document.documentElement.lang,
    });
  });
`;

const t = useTranslations(lang);
---

<!doctype html>
<html lang={bcp47[lang]} dir={direction[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead {...seoProps} />
    <meta name="theme-color" content={SHEET_LIGHT.base} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SHEET.base} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Fonts are self-hosted (see scripts/fetch-fonts.py) — no third-party request. */}
    <link
      rel="preload"
      href="/fonts/noto-serif-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-sans-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Design tokens: src/styles/tokens.css, generated from src/brand/tokens.ts by `pnpm tokens`. */}
    <style is:global set:html={tokensCss}></style>

    <script is:inline>
      // Flip off the no-JS fallback before first paint so revealed sections
      // start hidden rather than flashing in and then animating.
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline>
      // The reader's theme choice, if they made one in the header; otherwise
      // the page follows the device. Applied before first paint so a dark
      // reader never sees a light flash, and again after every router swap,
      // which replaces <html>'s attributes with the new document's.
      // Byte-identical on every page, so the router does not re-run it.
      (function () {
        function apply() {
          try {
            var chosen = localStorage.getItem('theme');
            if (chosen === 'light' || chosen === 'dark') {
              document.documentElement.dataset.theme = chosen;
            }
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {/* Google Analytics. Loaded on every sheet, unlike the Cal.com embed on /book. */}
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline set:html={gaBootstrap}></script>

    <ClientRouter />
  </head>

  <body>
    {/* The sheet, bottom to top: ground, ruling, drawings, rail. */}
    <div class="sheet-ground" aria-hidden="true"></div>
    <div class="blueprint" aria-hidden="true"></div>
    <Schematics />
    {/* The Bundu mineral strip: fixed to the left edge, full height, every page. */}
    <MineralStrip transition:persist />

    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    <div class="page">
      <MziziHeader path={path} lang={lang} switchHref={switchHref} />

      <main id="main" class="shell" transition:animate={unroll}>
        <slot />
      </main>

    </div>

    <MziziFooter lang={lang} sheet={sheet} path={path} />

    <script>
      // Reveal sections as they enter the viewport.
      //
      // threshold 0: a section taller than the viewport can never reach a
      // meaningful intersection ratio, so anything long would otherwise stay
      // at opacity 0 forever on a phone.
      //
      // Bound to astro:page-load rather than run once: the ClientRouter swaps
      // the document without a reload, so a one-shot observer would only ever
      // see the first page's sections and every later page would stay at
      // opacity 0. The old observer is disconnected first so they do not stack.
      let observer: IntersectionObserver | undefined;

      document.addEventListener('astro:page-load', () => {
        observer?.disconnect();

        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer?.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0 },
        );

        for (const target of document.querySelectorAll<HTMLElement>('.reveal')) {
          observer.observe(target);
        }
      });
    </script>
  </body>
</html>
