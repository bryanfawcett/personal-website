{
  "description": "checkAccessibility({body, cover}) -> findings in document order, cover first.",
  "cases": [
    {
      "name": "clean post",
      "input": {
        "body": [
          {
            "_type": "block",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "text": "Intro.",
                "marks": []
              }
            ]
          },
          {
            "_type": "block",
            "style": "h2",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "text": "Start",
                "marks": []
              }
            ]
          },
          {
            "_type": "block",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "text": "x",
                "marks": []
              }
            ]
          },
          {
            "_type": "block",
            "style": "h3",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "text": "More",
                "marks": []
              }
            ]
          },
          {
            "_type": "block",
            "style": "normal",
            "markDefs": [
              {
                "_key": "k1",
                "_type": "link",
                "href": "/adventures/mana-pools"
              }
            ],
            "children": [
              {
                "_type": "span",
                "text": "See ",
                "marks": []
              },
              {
                "_type": "span",
                "text": "the Mana Pools guide",
                "marks": [
                  "k1"
                ]
              }
            ]
          },
          {
            "_type": "image",
            "asset": {
              "_ref": "abc"
            },
            "alt": "A herd of elephants at dawn"
          }
        ],
        "cover": {
          "id": "m1",
          "alt": "Mana Pools at dawn"
        }
      },
      "expected": {
        "findings": []
      }
    },
    {
      "name": "empty input",
      "input": {},
      "expected": {
        "findings": []
      }
    },
    {
      "name": "body not an array",
      "input": {
        "body": "text",
        "cover": null
      },
      "expected": {
        "findings": []
      }
    },
    {
      "name": "no cover is fine",
      "input": {
        "body": [
          {
            "_type": "block",
            "style": "normal",
            "markDefs": [],
