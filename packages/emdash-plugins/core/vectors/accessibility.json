              {
                "_type": "span",
                "text": "x",
                "marks": []
              }
            ]
          }
        ]
      },
      "expected": {
        "findings": []
      }
    },
    {
      "name": "cover without alt",
      "input": {
        "cover": {
          "id": "m1"
        }
      },
      "expected": {
        "findings": [
          {
            "rule": "a11y.cover-alt",
            "severity": "error",
            "path": "cover",
            "message": "The cover image has no alt text. Open the cover image and describe what it shows in a short sentence, for people who cannot see it."
          }
        ]
      }
    },
    {
      "name": "cover with blank alt",
      "input": {
        "cover": {
          "id": "m1",
          "alt": "   "
        }
      },
      "expected": {
        "findings": [
          {
            "rule": "a11y.cover-alt",
            "severity": "error",
            "path": "cover",
            "message": "The cover image has no alt text. Open the cover image and describe what it shows in a short sentence, for people who cannot see it."
          }
        ]
      }
    },
