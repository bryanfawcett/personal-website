{
  "$schema": "https://emdashcms.com/schemas/emdash-plugin.schema.json",
  "slug": "link-policy",
  "version": "0.1.0",
  "name": "Link policy",
  "description": "Blocks publishing when a link is not http(s), mailto, tel, an on-site path or a fragment.",
