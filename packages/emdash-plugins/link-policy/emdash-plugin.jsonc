  "license": "TODO-owner",
  "publisher": "TODO-owner",
  // The trust contract. Must match the descriptor in src/index.ts (a test asserts it).
  "capabilities": ["hooks.content-policy:register"],
  "allowedHosts": [],
  "storage": {}
}
