{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bryanfawcett-site",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],

  // Almost every route is prerendered and served straight from assets. The four
  // blog routes under /adventures are not: they read Sanity per request, so
  // publishing a post is live without a rebuild — which matters because
  // Workers Builds only triggers on a git push, with no deploy hook a CMS
  // webhook could pull. That one exception is why this Worker has a `main`.
  //
  // The entrypoint is the adapter's own, not a file in this repo. Astro emits
  // the server bundle to dist/server and the static tree to dist/client; the
  // entrypoint stitches the two together and falls through to ASSETS for
  // anything prerendered.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "directory": "./dist/client",
    // Default html_handling (auto-trailing-slash) is right now that Astro
    // emits minerals.html rather than minerals/index.html: /minerals serves
    // directly and /minerals/ redirects to it. See `build.format` in
    // astro.config.mjs — that is what decides this, not a setting here.
    "not_found_handling": "404-page",

    // Without this the blog 404s for every real visitor.
    //
    // Assets are matched before the Worker runs, and a browser *navigation* —
    // `Sec-Fetch-Mode: navigate`, which only a browser sends — is answered
    // from the asset tree or from 404.html. /adventures is not in the asset
    // tree, so it never reached the Worker that renders it. curl returns a
    // clean 200 from the same URL because curl sends no such header, which is
    // exactly how this ships unnoticed; test navigations with the header set.
    //
    // Listed rather than `true` so every prerendered page keeps the fast
    // asset path and 404.html still answers an unknown URL.
    //
    // Note when changing anything in this block: the adapter bakes these
    // settings into dist/server/wrangler.json at build time, and that is what
    // takes effect. Editing this file alone changes nothing until `pnpm build`
    // runs again.
    "run_worker_first": ["/adventures", "/adventures/*", "/zh/adventures", "/zh/adventures/*"]
  },

  "observability": {
    "enabled": true
  }
}
