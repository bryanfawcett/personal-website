# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/

# build output
dist/
# The policy plugins' bundles are committed: Cloudflare's build does not run the bundler.
!packages/emdash-plugins/*/dist/

# astro generated types
.astro/

# wrangler local state and generated bindings
.wrangler/
worker-configuration.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# os
.DS_Store

.dev.vars*
!.dev.vars.example

# cf generated output
.cloudflare/

# rust tools
tools/target/
.playwright-mcp/
